+struct WaitCounterArgs {
+  int64_t* counter;
+  int64_t expected;
+};
+
+static void wait_counter_inner(void* raw_args) {
+  auto* args = reinterpret_cast<WaitCounterArgs*>(raw_args);
+  while (__atomic_load_n(args->counter, __ATOMIC_ACQUIRE) < args->expected) {
+    std::this_thread::yield();
+  }
+  args->expected += 1;
 }
 
