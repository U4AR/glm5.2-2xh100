+#ifndef CPUINFER_CPU_EXPERT_OPTS_H
+#define CPUINFER_CPU_EXPERT_OPTS_H
+
+#include <cstdlib>
+#include <string>
+#include <string_view>
+
+// Restart-scoped switches used to isolate the CPU expert optimizations. Parse
+// once so CUDA graph capture and replay always use the same implementation.
+inline bool kt_cpu_expert_opt_enabled(std::string_view option) {
+  static const std::string options = [] {
+    const char* value = std::getenv("KT_CPU_EXPERT_OPTS");
+    return value == nullptr ? std::string() : std::string(value);
+  }();
+
+  if (options.empty() || options == "none") return false;
+  if (options == "all") return true;
+
+  size_t begin = 0;
+  while (begin < options.size()) {
+    size_t end = options.find(',', begin);
+    if (end == std::string::npos) end = options.size();
+    size_t first = options.find_first_not_of(" \t", begin);
+    size_t last = end == begin ? std::string::npos : options.find_last_not_of(" \t", end - 1);
+    if (first != std::string::npos && first < end && last != std::string::npos &&
+        std::string_view(options).substr(first, last - first + 1) == option) {
+      return true;
+    }
+    begin = end + 1;
+  }
+  return false;
+}
+
+#endif  // CPUINFER_CPU_EXPERT_OPTS_H
