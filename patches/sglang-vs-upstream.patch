+def get_nsa_indexer_pattern(config: PretrainedConfig) -> Optional[str]:
+    """Per-layer 'F'(ull)/'S'(hared) indexer map, or None when every layer is Full.
+
+    GLM-5.2 trains with IndexShare: the lightning indexer lives on the first
+    layer of each group of four and the top-k it picks is reused by the rest of
+    the group, so only 21 of 78 layers ship indexer weights. A 'Shared' layer
+    therefore has neither an indexer nor an index-k cache of its own.
+    """
+    # Explicit override wins; upstream spells this as a bare F/S string.
+    pattern = getattr(config, "index_topk_pattern", None)
+    if isinstance(pattern, str) and pattern:
+        return pattern.upper()
+
+    # What GLM-5.2's own config carries.
+    types = getattr(config, "indexer_types", None)
+    if types:
+        return "".join("F" if str(t).lower() == "full" else "S" for t in types)
+
+    # Fallback: a uniform every-Nth-layer schedule.
+    freq = getattr(config, "index_topk_freq", None)
+    if isinstance(freq, int) and freq > 1:
+        offset = getattr(config, "index_skip_topk_offset", 0) or 0
+        return "".join(
+            "F" if i < offset or (i - offset) % freq == freq - 1 else "S"
+            for i in range(config.num_hidden_layers)
+        )
+    return None
+
+
+def nsa_layer_has_own_indexer(config: PretrainedConfig, layer_id: int) -> bool:
+    """Layers past the pattern (the NEXTN/MTP layer) always own an indexer."""
+    pattern = get_nsa_indexer_pattern(config)
+    if pattern is None or layer_id >= len(pattern):
+        return True
+    return pattern[layer_id] != "S"
+
