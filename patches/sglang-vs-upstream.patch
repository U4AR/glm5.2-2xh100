+def _parse_keep_k_from_model(model: Optional[str]) -> Optional[int]:
+    """Extract the expert-keep tier N from a model name like '<base>-topN'.
+
+    Returns N clamped to [0, 8], an adaptive sentinel for '<base>-adaptN', or
+    None when the name has no tier suffix (in which case the server default tier
+    applies). Adaptive N is a 0..100 speed level: 0 is exactly K=8/full routing,
+    higher values choose smaller K more often, levels above 75 may choose K=0
+    for very confident rows, and 100 is exactly K=0/top0-style maximum speed.
+    Bare '-adapt' aliases '-adapt50'. Selecting the tier purely via the OpenAI
+    ``model`` field keeps the API standard and switches live, per request, with
+    no restart.
+    """
+    if not model:
+        return None
+    nm = _KT_NUC_RE.search(model)
+    if nm:
+        pp = max(0, min(100, int(nm.group(1))))
+        return _KT_NUC_BASE - pp
+    am = _KT_ADAPT_RE.search(model)
+    if am:
+        level_s = am.group(1)
+        level = _KT_ADAPT_DEFAULT_SPEED if level_s == "" else int(level_s)
+        level = max(0, min(100, level))
+        return _KT_ADAPT_BASE - level
+    m = _KT_TOPN_RE.search(model)
+    if not m:
+        return None
+    try:
+        return max(0, min(8, int(m.group(1))))
+    except ValueError:
+        return None
+
