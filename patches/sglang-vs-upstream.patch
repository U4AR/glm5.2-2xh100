+# launches per layer and is worth 12.3x on its own; the GEMM is one launch. So
+# stacking is OFF by default and the lookahead gate runs as its own GEMM --
+# two extra launches per layer instead of thirty-six, at zero memory cost.
+_KT_PRED_FUSED_STACK = os.environ.get("KT_PRED_FUSED_STACK") == "1"
+# layer_id -> MoE module, registered at CONSTRUCTION (not first forward, which
+# may already be a CUDA-graph capture) so the gate stack can be built the moment
+# weights finish loading.
+_KT_PRED_MOE: Dict[int, "DeepseekV2MoE"] = {}
+# Holds the stacked gate tensor alive; every layer's gate.weight is a view into
+# it, so this must outlive them.
+_KT_PRED_GATE_STACK: List[torch.Tensor] = []
+
+
+def _kt_fuse_gates() -> None:
+    """Re-lay the MoE gate weights contiguously and hand each layer a slice
+    covering itself AND its successor.
+
+    Called once, after weights load and before any forward. Row-major slices of
+    rows are contiguous, so `gate.weight` keeps exactly the layout every other
+    consumer already expects -- only its storage moves.
+    """
+    lids = sorted(l for l, m in _KT_PRED_MOE.items()
+                  if not getattr(m, "is_nextn", False))
+    mods = [_KT_PRED_MOE[l] for l in lids]
+    gates = [getattr(m, "gate", None) for m in mods]
+    if len(gates) < 2 or any(g is None or getattr(g, "weight", None) is None
+                             for g in gates):
+        logger.info("[kt-pred-fused] no usable gate stack; staying unfused")
+        return
+    w0 = gates[0].weight
+    n_exp, hidden = int(w0.shape[0]), int(w0.shape[1])
+    if any(tuple(g.weight.shape) != (n_exp, hidden) for g in gates):
+        logger.info("[kt-pred-fused] gate shapes differ; staying unfused")
+        return
+    # STAGE THROUGH HOST MEMORY. Allocating the 225 MiB stack while the 75
+    # original gates are still resident needs both at once, and on this box that
+    # is fatal -- not at the moment of the copy, where 7.3 GB is free, but later:
+    # the originals live in allocator segments shared with other weights, so
+    # freeing them returns almost nothing to the driver even after
+    # empty_cache(), and the NEXTN load 7 GB later dies 28 MiB short with
+    # 706 MiB reserved-but-unallocated. Measured three times, byte-identical,
+    # and unchanged by expandable_segments.
+    #
+    # Going via the host makes the peak GPU footprint max(old, new) instead of
+    # old + new, so the re-layout is genuinely net-zero.
+    host = torch.empty((len(gates) * n_exp, hidden), dtype=w0.dtype,
+                       device="cpu")
+    dev = w0.device
+    for i, g in enumerate(gates):
+        host[i * n_exp:(i + 1) * n_exp].copy_(g.weight.data.to("cpu"))
+        g.weight = None            # drop the last reference to the GPU tensor
+    del w0
+    torch.cuda.empty_cache()
+    stack = host.to(dev)
+    del host
+    for i, g in enumerate(gates):
+        g.weight = torch.nn.Parameter(stack[i * n_exp:(i + 1) * n_exp],
+                                      requires_grad=False)
+    # PREDICT ON A SUBSET OF LAYERS. The predictor costs 1.81 ms/step spread
+    # over 75 layers -- ~24 us each, for one selection kernel on four tokens --
+    # and that is charged whether or not the layer had anything worth fetching.
+    # Against a 53.4 ms floor and a 54 ms target it is the binding term, and
+    # halving the layers halves it.
+    #
+    # The decision is made HERE, once, before capture: a layer with no
+    # `_kt_fused_next` emits nothing, so the graph simply has no nodes for it.
+    # A per-step branch could not do this -- captured graphs replay every node
+    # regardless of what the data says.
+    #
+    # It also drops BOTH halves of the cost together, since the same flag gates
+    # the widened gate GEMM. A skipped layer's misses fall back to substitution
+    # from the resident pool, which is a quality cost, not a correctness one.
+    # Keyed on the LAYER ID, not the position in this list, so the stacked path
+    # and the unstacked one at forward() pick the SAME layers. Keying one on the
+    # list index and the other on layer_id selects two different sets of the
+    # same size, which would look like a wash while comparing different things.
+    stride = _KT_PRED_LAYER_STRIDE
+    fused = 0
+    for i, m in enumerate(mods):
+        # Only a layer whose successor is the very next layer id can share a
+        # GEMM: the slice has to be two ADJACENT blocks of the stack.
+        if (lids[i] % stride == 0 and i + 1 < len(mods)
+                and lids[i + 1] == lids[i] + 1):
+            m._kt_fused_gate_w = stack[i * n_exp:(i + 2) * n_exp]
+            m._kt_fused_next_lid = lids[i + 1]
+            m._kt_fused_next = mods[i + 1]
+            fused += 1
+        else:
+            m._kt_fused_gate_w = None
+            m._kt_fused_next = None
+    _KT_PRED_GATE_STACK.append(stack)
+    # The 75 original gate tensors are now unreferenced, but the caching
+    # allocator keeps their blocks, so the process looks 225 MiB heavier than it
+    # is. On this box that is fatal: weight loading finishes with roughly 100
+    # MiB of headroom (TODO item 7), and the NEXTN load that follows died asking
+    # for 28 MiB. The restack is net-zero memory only if the freed blocks go
+    # back to the driver.
+    torch.cuda.empty_cache()
+    logger.info("[kt-pred-fused] stacked %d gates (%d x %d, %.1f MiB); "
+                "%d layers share their successor's GEMM (stride %d); %.0f MiB free",
+                len(gates), n_exp, hidden,
+                stack.numel() * stack.element_size() / 1048576.0, fused, stride,
+                torch.cuda.mem_get_info(stack.device)[0] / 1048576.0)
+
+
+def _kt_pred_topP(tgt, h, p):
+    """Run target layer `tgt`'s OWN gate and topk on hidden state `h`.
+
+    Using the target's own `topk` module rather than raw gate logits is
+    load-bearing: the sigmoid/bias/group scoring path is most of the apparent
+    "prediction error" otherwise (depth 0 read 71% instead of 100%).
+    """
+    logits = tgt.gate(h, None)
+    if isinstance(logits, tuple):
+        logits = logits[0]
+    out = tgt.topk(h, logits)
+    p = min(p, out.topk_weights.shape[1])
+    return torch.gather(out.topk_ids.long(), 1,
+                        torch.topk(out.topk_weights, p, dim=-1).indices)
+
+
+def _kt_pred_measure(moe, hidden_states, router_logits, topk_output,
+                     quant_method=None):
+    """Score past predictions of this layer, then predict for future layers.
+
+    Runs entirely on static shapes over persistent buffers, so it captures into
+    the decode graph and keeps scoring on replay. Both halves happen in the same
+    forward: layer L reads the inbox that layer L-n filled earlier in THIS pass,
+    which is exactly the lead time a real prefetch would have.
+
+    Ten accumulators per (depth, P). Recall (HIT/TOT) is the headline number but
+    it is NOT what the payoff is denominated in: a prefetch only removes a
+    layer's CPU submit/sync when EVERY non-resident expert that layer needs was
+    fetched, and a partially covered layer keeps paying the expensive
+    head-of-line contention regime. So FULL/ACTIVE -- the fraction of
+    CPU-touching layer-calls covered COMPLETELY -- is measured directly rather
+    than approximated as recall**D, which assumes the misses are independent
+    within a layer. NEED/COV give the partial-credit term, SET gives the bytes.
+
+    BLEND_* score the union of the prediction with the set this same layer
+    needed on the PREVIOUS step (free persistence). The two signals are near
+    independent -- 75% and 27% -- so their union may cover more layers than
+    either, at the cost of a larger fetch (BLEND_SET).
+    """
+    T = int(hidden_states.shape[0])
+    if T > _KT_PRED_TMAX or T == 0:
+        return
+    lid = int(getattr(moe, "layer_id", -1))
+    _KT_PRED_LAYERS[lid] = moe
+
+    # Prefetch needs the PREDICTION but not the SCORING. Scoring is 4-9 cells
+    # per layer per step and pushes the fitted floor from 59.54 ms to ~90 ms --
+    # it would swamp the very speedup it exists to measure. So when the
+    # instrument is off, emit and get out.
+    if not _KT_PRED_SCORE:
+        if _KT_PRED_POINT == "pre":
+            _kt_pred_emit(lid, hidden_states,
+                          is_nextn=getattr(moe, "is_nextn", False))
+        return
+
+    # The genuine top-K this layer actually routed, by router weight.
+    w = topk_output.topk_weights
+    ids = topk_output.topk_ids.long()
+    k = min(_KT_PRED_K, w.shape[1])
+    true_ids = torch.gather(ids, 1, torch.topk(w, k, dim=-1).indices)  # (T, k)
+
+    stats = getattr(moe, "_kt_pred_stats", None)
+    inbox = getattr(moe, "_kt_pred_inbox", None)
+    prev = getattr(moe, "_kt_pred_prevneed", None)
+    # Which of the genuine top-K actually cost a CPU round-trip. A prefetcher
+    # only has to cover THESE; the GPU-resident members are already free, and
+    # scoring against all of them would flatter whole-layer coverage.
+    mask = getattr(quant_method, "gpu_experts_mask_cuda", None)
+    if (stats is None or inbox is None or prev is None
+            or router_logits is None or mask is None):
+        # Still emit: a layer that cannot be SCORED (no residency mask, e.g. a
+        # non-kt layer) must not break the prediction chain for the layers
+        # behind it, which read the inbox this call is responsible for filling.
+        if _KT_PRED_POINT == "pre":
+            _kt_pred_emit(lid, hidden_states,
+                          is_nextn=getattr(moe, "is_nextn", False))
+        return
+    n_exp = router_logits.shape[1]
+    allow_vec = mask.to(torch.bool)
+    # A predicted expert that is ALREADY GPU-resident costs nothing to "fetch",
+    # so the transfer columns must be intersected with this before they mean
+    # bytes. Counting |predicted| instead reported 7.31 experts per layer-call
+    # against 1.98 actually needed, which is a ~3.7x overstatement of the link
+    # cost and would have priced every superset out on sight.
+    nonres = ~allow_vec
+    need = torch.zeros(n_exp, device=w.device, dtype=torch.float32)
+    need.index_add_(0, true_ids.reshape(-1),
+                    (~allow_vec[true_ids]).float().reshape(-1))
+    need_b = need > 0
+    n_need = need_b.sum().to(torch.float32)
+    active = (n_need > 0).to(torch.float32)
+    prev_b = prev > 0
+
+    for slot, n in enumerate(_KT_PRED_DEPTHS):
+        # Depth 0 is the wiring self-check: same pass, same layer, scored
+        # through the real path, so it MUST read 100%. Without it a low number
+        # at depth >=1 cannot be attributed to hidden-state drift rather than
+        # to the harness comparing two different notions of "top-K".
+        pred_all = true_ids if n == 0 else inbox[slot][:T]      # (T, k|PMAX)
+        # (T, k, P) once, then every P is a prefix reduction over the last dim.
+        eq = true_ids.unsqueeze(-1) == pred_all.unsqueeze(1)
+        pset = torch.zeros(n_exp, device=w.device, dtype=torch.float32)
+        done = 0
+        for pi, P in enumerate(_KT_PRED_P):
+            pp = min(P, pred_all.shape[1])
+            # Set overlap, not positional equality, and scored on the TRUE side:
+            # with a superset (P > k) precision and recall diverge, and what a
+            # prefetcher needs is recall.
+            hit = eq[:, :, :pp].any(-1).sum().to(torch.float32)
+            tot = hit.new_full((), float(T * k))
+            if pp > done:
+                new = pred_all[:, done:pp].reshape(-1)
+                pset.index_add_(0, new, torch.ones_like(new, dtype=torch.float32))
+                done = pp
+            psb = pset > 0
+            cov = (need_b & psb).sum().to(torch.float32)
+            full = ((cov >= n_need) & (n_need > 0)).to(torch.float32)
+            bl = psb | prev_b
+            bcov = (need_b & bl).sum().to(torch.float32)
+            bfull = ((bcov >= n_need) & (n_need > 0)).to(torch.float32)
+            stats[slot, pi].add_(
+                torch.stack([hit, tot, full, active, n_need, cov,
+                             bfull, bcov,
+                             (bl & nonres).sum().to(torch.float32),
+                             (psb & nonres).sum().to(torch.float32)]).to(stats.dtype)
+            )
+    prev.copy_(need_b.to(prev.dtype))
+
+    if _KT_PRED_POINT == "pre":
+        _kt_pred_emit(lid, hidden_states,
+                      is_nextn=getattr(moe, "is_nextn", False))
+
+
+# Stage C: which lookahead depth actually drives the fetch. The instrument can
+# score several depths at once, but only one of them may move bytes.
+_KT_PREFETCH_DEPTH = int(os.environ.get("KT_PREFETCH_DEPTH", "1") or "1")
+# Scoring is the instrument; prediction is the mechanism. They are independent.
+_KT_PRED_SCORE = os.environ.get("KT_PLACE_SCORE") == "1"
+
+
+def _kt_prefetch_issue(target_lid, predicted_ids):
+    """Hand a prediction to the target layer's kt wrapper, if prefetch is on."""
+    try:
+        from sglang.srt.layers.moe.kt_ep_wrapper import (
+            _KT_PREFETCH_ENABLED, _KT_PREFETCH_LAYERS,
+        )
+    except Exception:
+        return
+    if not _KT_PREFETCH_ENABLED:
+        return
+    m = _KT_PREFETCH_LAYERS.get(int(target_lid))
+    if m is not None:
+        m.pf_issue(predicted_ids)
+
+
+def _kt_pred_fused_emit(moe, both, n_exp, col_off=None) -> None:
+    """Hand the lookahead half of the fused gate output straight to the fetcher.
+
+    This replaces the entire unfused chain for depth 1 -- target gate GEMM,
+    sigmoid/bias scoring, top-8, top-P gather, inbox write, then pf_issue's ~28
+    selection ops -- with one kernel that reads a column slice in place.
+
+    The bias must be the TARGET layer's `e_score_correction_bias`: the scoring
+    is noaux_tc, so using this layer's own would rank the next layer's logits
+    against the wrong correction and quietly degrade the prediction rather than
+    fail. Cached on first use because a `.float()` per layer per step would put
+    back one of the launches this exists to remove.
+    """
+    nxt = getattr(moe, "_kt_fused_next", None)
+    if nxt is None:
+        return
+    qm = getattr(getattr(nxt, "experts", None), "quant_method", None)
+    if qm is None or not hasattr(qm, "pf_issue_fused") or qm.pf_table is None:
+        return
+    bias = getattr(nxt, "_kt_fused_bias", None)
+    if bias is None:
+        b = getattr(getattr(nxt, "gate", None), "e_score_correction_bias", None)
+        if b is None:
+            # No correction bias means plain sigmoid ranking; a zero vector is
+            # the exact equivalent and keeps the kernel signature fixed.
+            b = torch.zeros(n_exp, dtype=torch.float32, device=both.device)
+        bias = b.detach().to(torch.float32).contiguous()
+        nxt._kt_fused_bias = bias
+    qm.pf_issue_fused(both, bias, n_exp if col_off is None else col_off,
+                      _KT_PRED_FUSED_TOPK, _KT_PRED_PMAX)
+
+
+def _kt_pred_emit(lid, h, norm_of=None, is_nextn=False):
+    """Fill the inbox of every layer `lid + n` from the hidden state `h`.
+
+    The write lands in the TARGET layer's inbox and is read later in this same
+    forward pass, which is exactly the lead time a real prefetch would get.
+    `norm_of`, when given, is a callable(target_layer_id) -> the normalisation
+    to apply before the target's gate sees `h` (the "post" point feeds a raw
+    residual stream and must renormalise per target).
+    """
+    if is_nextn:
+        # The NEXTN/MTP draft reuses this code path but is captured into its OWN
+        # graph, which contains only its single layer. A fetch issued from here
+        # targets a TARGET-model layer whose apply() -- and therefore the
+        # wait_event that rejoins pf_stream -- never runs inside that capture,
+        # so capture ends with a forked stream still outstanding and dies with
+        # cudaErrorStreamCaptureUnjoined. It only bites when lid + depth happens
+        # to land on a real MoE layer, which is exactly why depths 1 and 2
+        # booted and depth 3 did not. The draft's predictions are worthless
+        # anyway: the target model re-runs every layer straight afterwards.
+        return
+    for slot, n in enumerate(_KT_PRED_DEPTHS):
+        if n == 0:
+            continue
+        tgt = _KT_PRED_LAYERS.get(lid + n)
+        if tgt is None or getattr(tgt, "_kt_pred_inbox", None) is None:
+            continue
+        if getattr(tgt, "is_hash", False):
+            continue          # hash routing needs input_ids, not the hidden state
+        with torch.no_grad():
+            x = h if norm_of is None else norm_of(lid + n, h)
+            if x is None:
+                continue
+            top = _kt_pred_topP(tgt, x, _KT_PRED_PMAX)
+            tgt._kt_pred_inbox[slot][:top.shape[0], :top.shape[1]].copy_(top)
+            # Stage C: this is the moment the prefetch has to fire. The target
+            # layer's routing is now predicted and its MoE is still one whole
+            # layer away, which is the only lead time available -- an
+            # exact-schedule fetch issued after the target's own router would
+            # have zero slack and cost more than it saves.
+            if n == _KT_PREFETCH_DEPTH:
+                _kt_prefetch_issue(lid + n, top)
+
+
+def _kt_pred_post_hook(lid, hidden_states, residual, is_nextn=False):
+    """The "post" prediction point: layer `lid` has finished.
+
+    `hidden_states + residual` is the residual stream entering layer lid+1,
+    minus that layer's attention -- which is precisely the drift being measured.
+    It is PRE-norm, so it is renormalised with the TARGET layer's own
+    post_attention_layernorm before its gate sees it; feeding a raw residual
+    would confound the measurement with a scale mismatch the sigmoid/bias path
+    is not invariant to.
+    """
+    if residual is None or hidden_states is None:
+        return
+    T = int(hidden_states.shape[0])
+    if T > _KT_PRED_TMAX or T == 0:
+        return
+    x = hidden_states + residual
+
+    def norm_of(tgt_lid, v):
+        dl = _KT_PRED_DLAYERS.get(tgt_lid)
+        ln = getattr(dl, "post_attention_layernorm", None) if dl else None
+        if ln is None:
+            return None
+        out = ln(v)
+        return out[0] if isinstance(out, tuple) else out
+
+    _kt_pred_emit(lid, x, norm_of=norm_of, is_nextn=is_nextn)
+
+
+# --- Chain lookahead (KT_CHAIN_PRED=1) --------------------------------------
+# The shipped predictor above shows layer L's hidden state to layer L+d's router
+# and eats d layers of drift for it. The alternative is to spend the window in
+# which the CPU is computing this layer's non-resident experts running an
+# APPROXIMATE next layer on the GPU-resident experts only, then route from a
+# stream that has actually moved -- and repeat, a few layers ahead. Which of the
+# two predicts better is an empirical question, so it is measured before
+# anything is built on it. All of the logic lives in bench/chain_predict.py;
+# these hooks only hand it the three things it cannot reach from inside the MoE:
+# the genuine routing, the pre-MoE residual stream, and the post-layer stream.
+_KT_CHAIN = os.environ.get("KT_CHAIN_PRED") == "1"
+_kt_chain_mod = None
+
+
+def _kt_chain():
+    """Import the instrument from the repo's bench/ dir, once, lazily."""
+    global _kt_chain_mod
+    if _kt_chain_mod is None:
+        try:
+            import sys as _sys
+            from pathlib import Path as _Path
+            # Walk up to the repo root rather than counting parents: this file
+            # lives deep inside .venv/, so a fixed index is unreadable and wrong
+            # the moment anything moves.
+            _bench = None
+            for _p in _Path(__file__).resolve().parents:
+                _cand = _p / "bench" / "chain_predict.py"
+                if _cand.is_file():
+                    _bench = str(_cand.parent)
+                    break
+            if _bench is None:
+                _bench = os.environ.get("KT_BENCH_DIR", "")
+            if _bench and _bench not in _sys.path:
+                _sys.path.insert(0, _bench)
+            import chain_predict as _cp
+            _kt_chain_mod = _cp
+        except Exception:
+            logger.exception("[kt-chain] instrument unavailable")
+            _kt_chain_mod = False
+    return _kt_chain_mod or None
+
+
+# The MECHANISM, as opposed to the instrument above: a capture-safe chain walk
+# that drives the real prefetch from inside the decode CUDA graph. Separate
+# module and separate flag because the two have opposite constraints -- the
+# instrument may do anything and runs eager, this may do almost nothing and must
+# capture.
+_KT_CHAIN_PF = os.environ.get("KT_CHAIN_PF") == "1"
+_kt_chain_pf_mod = None
+
+
+def _kt_chain_pf():
+    global _kt_chain_pf_mod
+    if _kt_chain_pf_mod is None:
+        try:
+            import sys as _sys
+            from pathlib import Path as _Path
+            _bench = None
+            for _p in _Path(__file__).resolve().parents:
+                _cand = _p / "bench" / "chain_prefetch.py"
+                if _cand.is_file():
+                    _bench = str(_cand.parent)
+                    break
+            if _bench is None:
+                _bench = os.environ.get("KT_BENCH_DIR", "")
+            if _bench and _bench not in _sys.path:
+                _sys.path.insert(0, _bench)
+            import chain_prefetch as _cp
+            _kt_chain_pf_mod = _cp
+        except Exception:
+            logger.exception("[kt-chain-pf] mechanism unavailable")
+            _kt_chain_pf_mod = False
+    return _kt_chain_pf_mod or None
+
+
+# Decode-time adaptive expert cache (KT_ADAPTIVE_DECODE=1): accumulate the
+# GENUINE top-2 firing mass per expert into a persistent CUDA buffer hung on
+# the layer's quant_method (`_kt_decode_counts`, pre-allocated in
+# kt_ep_wrapper.process_weights_after_loading, OUTSIDE graph capture). Pure
+# static-shape device ops -> capture-safe, unlike _KT_HIT_STATS (D2H syncs,
+# eager-only). Consumed by kt_ep_wrapper.kt_adaptive_on_decode_step().
+_KT_ADAPTIVE = os.environ.get("KT_ADAPTIVE_DECODE") == "1"
+# --- Three-tier expert store (see kt_ep_wrapper: KT_RAM_EXPERTS) -------------
+# KT_TIER_FILL_POOL: which experts may be used as the "nearest equivalent" when
+# a routed expert is substituted.
+#   gpu (default) — GPU-resident only. This is the SHIPPED safe-mode contract:
+#                   the whole point of substituting the tail is that the tail
+#                   then never touches the CPU expert path, which is the decode
+#                   bottleneck.
+#   resident      — GPU | RAM. Closer to the router's intent for an SSD-tier
+#                   expert, but every fill that lands in RAM buys a CPU
+#                   round-trip.
+#
+# Defaulting this to `resident` was a 35% decode regression and it is worth
+# recording why, because the symptom pointed the wrong way. With the RAM tier
+# full (nothing on SSD) `resident` is ALL 256 experts, so the six substituted
+# tail slots of a top-2 request were being filled with the best-scoring expert
+# anywhere -- usually a CPU expert. A tail that used to cost zero CPU trips
+# started costing up to six. It also produced a plausible-looking but false
+# headline: decode appeared to get FASTER as the RAM tier shrank, purely
+# because a smaller RAM tier makes this pool more GPU-only, walking the bug
+# back toward the shipped behaviour.
+_KT_TIER_FILL_POOL = os.environ.get("KT_TIER_FILL_POOL", "gpu")
+# GPU-ONLY EXPERTS. Keep a genuine top-K expert only if it is already on the GPU
+# or the prefetcher landed it; substitute anything else from the resident pool.
+# The CPU expert path becomes zero BY CONSTRUCTION rather than by coverage.
+#
+# The point is not speed at a fixed K -- it is that full routing becomes
+# affordable. K=8 with the CPU costs 149.48 ms/step; here it costs the 52.90 ms
+# floor plus 1.64 + ~5.1 x f of prefetch, where f is bounded by the number of
+# landing slots. Slots therefore become a QUALITY dial: more slots, more of the
+# genuine top-K survives, at ~5.1 ms each.
+#
+# NOTE this mode requires KT_PREFETCH_SELECTIVE=0. The all-or-nothing rule exists
+# because a partially covered layer still pays its CPU call, so partial bytes buy
+# nothing -- but there is no CPU call here, and every landed expert is one fewer
+# substitution. Leaving SELECTIVE on would throw away most of the quality.
+_KT_GPU_ONLY = os.environ.get("KT_GPU_ONLY") == "1"
+# KT_TIER_COUNT_MODE: which routed experts vote in the cache-update counters.
+# Votes are cast on PRE-substitution ids, which is what makes an SSD-tier
+# expert discoverable at all — it is counted on the step it fires even though
+# a resident stand-in did the compute.
+#   top2  — only the genuine top-2 vote (what actually costs a CPU round-trip).
+#   top8  — every routed expert votes, unweighted.
+#   top8w — every routed expert votes, weighted by its router weight, so a
+#           rank-8 expert holding 2% of the mass cannot buy a slot as cheaply
+#           as a rank-1 expert.
+_KT_TIER_COUNT_MODE = os.environ.get("KT_TIER_COUNT_MODE", "top2")
+_KT_TIER_COUNT_K = 2 if _KT_TIER_COUNT_MODE == "top2" else 8
+_KT_TIER_COUNT_WEIGHTED = _KT_TIER_COUNT_MODE == "top8w"
+
+# --- Expert ENERGY: two-timescale demand model driving tier placement -------
+# Per (layer, expert) — an expert is layer-local, so every buffer below is
+# per-layer. Each decode step, for the router distribution p over ALL experts
+# (not just the routed top-8; the tail carries real signal about what is about
+# to become hot):
+#
+#   E_slow <- Ls * E_slow + p                      persistent demand
+#   E_fast <- Lf(e) * E_fast + p * idf             transient surge
+#   idf     = c / (rate_slow + c),  rate_slow = E_slow * (1 - Ls)
+#   Lf(e)   = Lmin + (Lmax-Lmin) * (p_e/(p_e + k*mean(p)))**beta  STICKY DECAY
+#   E       = rate_slow + alpha * rate_fast,  rate_fast = E_fast * (1 - Lmin)
+#
+# STICKY DECAY: the descent rate is itself a function of incoming mass. An
+# expert still drawing router weight THIS STEP -- even a trickle from OUTSIDE
+# the top-8 -- decays slowly (Lf -> Lmax), while one drawing nothing decays at
+# Lmin and is gone in ~4 steps. So residency time scales with sustained demand
+# instead of being a fixed timer, and an expert that is "almost" being used
+# keeps its slot rather than thrashing in and out. p covers the full router
+# distribution, not just the routed experts; mean(p) makes it self-scaling.
+#
+# Why this shape:
+#   * Two timescales. E_slow (half-life ~700 steps) holds the Zipf head in
+#     place. E_fast (half-life ~2.4 steps) is the "promote it NOW" term: one
+#     firing lifts an expert immediately and it decays back over ~4 steps
+#     unless re-hit. Repeated hits both re-bump E_fast and build E_slow, so a
+#     genuinely recurring expert graduates from a transient visitor to a
+#     resident. That is the "gets enough energy -> GPU, else RAM" rule.
+#   * idf on the TRANSIENT TERM ONLY. A rare expert that suddenly fires needs a
+#     big kick to overtake incumbents; a common expert does not, because it is
+#     already resident. Applying idf to the persistent term instead would
+#     demote exactly the experts that should stay — it would punish popularity.
+#     The form c/(rate+c) is a bounded inverse frequency: ~1 for an unseen
+#     expert, falling smoothly toward 0 for a saturated one, with no division
+#     blow-up at rate=0.
+#   * Rates, not raw accumulators. E_slow saturates near p/(1-Ls) and E_fast
+#     near p*idf/(1-Lf); multiplying each by its own (1-L) puts both on the
+#     same "mass per step" scale so alpha is a meaningful trade-off knob
+#     rather than an arbitrary factor of 1000.
+#
+# Every op is a fixed-shape in-place update on a persistent buffer, so this
+# captures into the decode CUDA graph like the top-2 counters do.
+_KT_ENERGY = os.environ.get("KT_ENERGY") == "1"
+_KT_ENERGY_LF = float(os.environ.get("KT_ENERGY_LAMBDA_FAST", "0.75"))
+_KT_ENERGY_LF_MAX = float(os.environ.get("KT_ENERGY_LAMBDA_FAST_MAX", "0.97"))
+_KT_ENERGY_STICKY_K = float(os.environ.get("KT_ENERGY_STICKY_K", "1.0"))
+_KT_ENERGY_STICKY_BETA = float(os.environ.get("KT_ENERGY_STICKY_BETA", "0.3"))
+_KT_ENERGY_LS = float(os.environ.get("KT_ENERGY_LAMBDA_SLOW", "0.999"))
+_KT_ENERGY_IDF_C = float(os.environ.get("KT_ENERGY_IDF_C", "0.02"))
+_KT_HIT_LOG_EVERY = int(os.environ.get("KT_HIT_LOG_EVERY", "64"))  # decode tokens
+_KT_HIT_ACC = {
+    "layer_calls": 0,      # MoE-layer forwards seen (≈ tokens × n_moe_layers)
+    "tokens_est": 0.0,     # Σ token-rows across calls
+    "top2_res": 0.0,       # Σ genuine top-2 slots that were GPU-resident
+    "top2_tot": 0.0,       # Σ genuine top-2 slots (= 2 × tokens)
+    "top1_res": 0.0,       # Σ genuine top-1 slots resident
+    "cpu_exp": 0.0,        # Σ genuine-kept slots that were NON-resident (fire on CPU)
+    "kept_tot": 0.0,       # Σ genuine-kept slots
+    "zero_cpu_layers": 0.0,  # Σ (layer,token) pairs whose kept set is fully resident
+    "last_log_tokens": 0,
+}
+# cumulative union of logical expert ids ever activated (working-set size)
+_KT_HIT_SEEN = None  # lazily a CPU bool tensor of size n_experts
+# per-(layer, expert) top-2 firing counts, for building an oracle placement mask.
+# Keyed by layer_id -> CPU float64 tensor[n_experts]. Dumped to KT_HIT_COUNTS_PT
+# when the control file /tmp/kt_dump_counts appears; reset on /tmp/kt_reset_counts.
+_KT_HIT_COUNTS = {}
+_KT_HIT_COUNTS_PT = os.environ.get("KT_HIT_COUNTS_PT", "/tmp/kt_hit_counts.pt")
+
+
+def _kt_dump_hit_counts():
+    """Serialize per-layer top-2 counts to a [max_layer+1, E] tensor on disk."""
+    if not _KT_HIT_COUNTS:
+        return
+    n_exp = next(iter(_KT_HIT_COUNTS.values())).numel()
+    max_l = max(_KT_HIT_COUNTS.keys())
+    out = torch.zeros(max_l + 1, n_exp, dtype=torch.float64)
+    for l, c in _KT_HIT_COUNTS.items():
+        out[l] = c
+    torch.save(out, _KT_HIT_COUNTS_PT)
+    logger.info("[kt-hit] dumped per-layer top-2 counts %s -> %s",
+                tuple(out.shape), _KT_HIT_COUNTS_PT)
+
+
+def _kt_record_hit_stats(ids, rank, keep_mask, allow_vec, K_vec, E, layer_id=-1):
+    """Accumulate decode-time residency stats (rank 0, eager only). Cheap: all
+    ops on the tiny decode tensor; no weight movement. Logs an EWMA-free running
+    average every ``_KT_HIT_LOG_EVERY`` decode tokens."""
+    global _KT_HIT_SEEN
+    try:
+        if torch.cuda.is_current_stream_capturing():
+            return
+    except Exception:
+        pass
+    try:
+        resident_slot = allow_vec[ids.long()]          # (T,E) genuine-id resident?
+        top2 = rank < 2                                  # (T,E)
+        top1 = rank < 1
+        kept = keep_mask                                 # rank < K (genuine kept)
+        a = _KT_HIT_ACC
+        T = int(ids.shape[0])
+        a["layer_calls"] += 1
+        a["tokens_est"] += float(T)
+        a["top2_res"] += float((top2 & resident_slot).sum().item())
+        a["top2_tot"] += float(top2.sum().item())
+        a["top1_res"] += float((top1 & resident_slot).sum().item())
+        cpu_slots = kept & (~resident_slot)              # non-resident genuine kept
+        a["cpu_exp"] += float(cpu_slots.sum().item())
+        a["kept_tot"] += float(kept.sum().item())
+        # per-(token) fully-resident-kept fraction (would let CPU be skipped)
+        cpu_per_row = cpu_slots.sum(dim=-1)              # (T,)
+        a["zero_cpu_layers"] += float((cpu_per_row == 0).sum().item())
+        # working-set union
+        n_exp = int(allow_vec.shape[0])
+        if _KT_HIT_SEEN is None or _KT_HIT_SEEN.numel() != n_exp:
+            _KT_HIT_SEEN = torch.zeros(n_exp, dtype=torch.bool)
+        seen_ids = ids.reshape(-1).to("cpu", torch.long)
+        _KT_HIT_SEEN[seen_ids] = True
+
+        # per-(layer, expert) top-2 firing counts for oracle mask building
+        if layer_id >= 0:
+            c = _KT_HIT_COUNTS.get(layer_id)
+            if c is None:
+                c = torch.zeros(n_exp, dtype=torch.float64)
+                _KT_HIT_COUNTS[layer_id] = c
+            top2_ids = ids[top2].reshape(-1).to("cpu", torch.long)
+            c.index_add_(0, top2_ids, torch.ones_like(top2_ids, dtype=torch.float64))
+
+        # decode tokens ≈ layer_calls / n_moe_layers; log on a token cadence
+        tokens_seen = a["tokens_est"]
+        if tokens_seen - a["last_log_tokens"] >= _KT_HIT_LOG_EVERY * 61:
+            a["last_log_tokens"] = tokens_seen
+            calls = max(a["layer_calls"], 1)
+            top2_hit = a["top2_res"] / max(a["top2_tot"], 1.0)
+            top1_hit = a["top1_res"] / max(a["top2_res"] + a["cpu_exp"], 1.0)
+            mean_cpu = a["cpu_exp"] / calls
+            zero_cpu = a["zero_cpu_layers"] / calls
+            logger.info(
+                "[kt-hit] top2_resident=%.1f%% top1_resident=%.1f%% "
+                "mean_cpu_experts/layer=%.3f zero-cpu-layers=%.1f%% "
+                "unique_experts_activated=%d layer_calls=%d",
+                100.0 * top2_hit, 100.0 * top1_hit, mean_cpu,
+                100.0 * zero_cpu, int(_KT_HIT_SEEN.sum().item()), int(calls),
+            )
+            # control files: reset accumulators / dump per-layer counts on demand
+            if os.path.exists("/tmp/kt_reset_counts"):
+                _KT_HIT_COUNTS.clear()
+                for k in a:
+                    a[k] = 0.0 if isinstance(a[k], float) else 0
+                globals()["_KT_HIT_SEEN"] = None
+                try:
+                    os.remove("/tmp/kt_reset_counts")
+                except OSError:
+                    pass
+                logger.info("[kt-hit] counters reset")
+            _kt_dump_hit_counts()
+    except Exception as _e:  # never let instrumentation break inference
+        pass
+
+
+def _kt_nucleus_keep_k(w, E, p, kmin, kmax):
+    """Per-token, per-layer nucleus K: the SMALLEST number of top experts whose
+    cumulative normalized router mass (over the E selected slots) reaches ``p``,
+    clamped to [kmin, kmax]. Fully tensorized / branch-free / shape-static, so it
+    is captured once into the decode CUDA graph and replays for any per-token
+    distribution. Returns a (T,) long tensor of per-token K in [kmin, kmax]."""
+    wf = w.float()
+    ws, _ = torch.sort(wf, dim=-1, descending=True)          # (T, E) desc
+    denom = torch.clamp(ws.sum(dim=-1, keepdim=True), min=1e-9)
+    cum = torch.cumsum(ws, dim=-1) / denom                   # cum[:, j] = mass of top-(j+1)
+    # count of prefix lengths still short of p == index where p is first reached.
+    # p may be a scalar OR a per-row (T,) tensor (per-request nucleus tier).
+    pcol = p.reshape(-1, 1).to(cum.dtype) if torch.is_tensor(p) else p
+    below = (cum < pcol).sum(dim=-1)                         # (T,)
+    k = below + 1                                            # smallest k reaching p
+    lo = max(1, min(int(kmin), E))
+    hi = max(lo, min(int(kmax), E))
+    return torch.clamp(k, lo, hi).to(torch.long)
+
+
+def _kt_adaptive_keep_k(w, E, speed_level=None):
+    """Choose per-token K from normalized top-8 router mass.
+
+    ``speed_level`` is 0..100 and acts as a quality/speed knob: 0 is exactly
+    K=8/full routing, higher values lower the mass thresholds and choose K=2/4
+    more often, and 100 is exactly K=0/top0-style maximum speed. Above level 75
+    very confident rows may choose K=0 before the endpoint, giving a continuous
+    high-speed band instead of a cliff at adapt100. Default 50 preserves the
+    original adaptive thresholds: top2>=0.50 and top4>=0.70. The math is all
+    tensorized and graph-capture friendly.
+    """
+    if _KT_ADAPT_NUCLEUS_P > 0:
+        return _kt_nucleus_keep_k(w, E, _KT_ADAPT_NUCLEUS_P, _KT_ADAPT_KMIN, _KT_ADAPT_KMAX)
+    wf = w.float()
+    ws, _ = torch.sort(wf, dim=-1, descending=True)
+    denom = torch.clamp(ws.sum(dim=-1), min=1e-9)
+    mass2 = ws[:, : min(2, E)].sum(dim=-1) / denom
+    mass4 = ws[:, : min(4, E)].sum(dim=-1) / denom
+    if speed_level is None:
+        speed_raw = torch.full_like(mass2, float(_KT_ADAPT_DEFAULT_SPEED))
+    else:
+        speed_raw = speed_level.to(device=w.device, dtype=torch.float32)
+    speed_raw = torch.clamp(speed_raw, 0.0, 100.0)
+    speed = speed_raw / 100.0
+    top2_threshold = 0.60 - 0.20 * speed
+    top4_threshold = 0.80 - 0.20 * speed
+    k0_ramp = torch.clamp((speed_raw - 75.0) / 25.0, 0.0, 1.0)
+    k0_threshold = 0.92 - 0.42 * k0_ramp
+    k2 = torch.full((w.shape[0],), min(2, E), device=w.device, dtype=torch.long)
+    k0 = torch.zeros_like(k2)
+    k4 = torch.full_like(k2, min(4, E))
+    k8 = torch.full_like(k2, E)
+    nonzero_k = torch.where(
+        mass2 >= top2_threshold,
+        k2,
+        torch.where(mass4 >= top4_threshold, k4, k8),
+    )
+    adaptive_k = torch.where(mass2 >= k0_threshold, k0, nonzero_k)
+    return torch.where(
+        speed_raw <= 0.0,
+        k8,
+        torch.where(speed_raw >= 100.0, k0, adaptive_k),
+    )
+
+
+def _kt_topk_experiment(topk_output, router_logits, quant_method, keep_k=None, layer_id=-1):
+    """Mutate topk_output in place per _KT_TOPK_MODE, with a PER-TOKEN K.
+
+    ``keep_k`` is an optional int tensor of shape (>=T,) giving the number of
+    genuine top experts to KEEP for each token (the rest are substituted /
+    dropped). When None, every token uses the process-global ``_KT_TOPK_K``
+    (legacy single-K behaviour). A per-token value of -2 selects adaptive K
+    with the default speed level 50. Values <= -1000 encode adaptive speed
+    levels 0..100 as ``-1000 - level``. Level 0 is exactly K=8/full routing,
+    higher levels lower the router-mass thresholds, levels above 75 may choose
+    K=0 for very confident rows, and level 100 is exactly K=0/top0-style
+    maximum speed. The form is
+    BRANCH-FREE and SHAPE-STATIC so it is captured once into the decode CUDA
+    graph and replays for any mix of per-token K values — that is what lets the
+    OpenAI ``model`` field (``...-topN`` / ``...-adaptN``) select the
+    speed/quality tier live, per request, with different tiers sharing one batch
+    and one graph (no recapture, ever).
+
+    K == E (e.g. -top8) is exactly the baseline: keep_mask is all-True so the
+    original routing passes through untouched and the renorm is a no-op.
+    """
+    w = topk_output.topk_weights  # (T, E) float
+    ids = topk_output.topk_ids    # (T, E) int
+    if w.numel() == 0:
+        return
+    T, E = w.shape
+
+    # Per-token K vector (T,) in [0, E]. A per-token value of -2 means adaptive
+    # default; values <= -1000 mean adaptive with a 0..100 speed level; other
+    # values <0 or >E (e.g. the -1 "no suffix" sentinel) fall back to the
+    # process-global default.
+    #
+    # The process default is per-layer/per-token NUCLEUS routing when
+    # KT_ADAPT_NUCLEUS_P > 0 (N chosen from the router's own cumulative mass at
+    # this layer/token), otherwise the fixed _KT_TOPK_K. Serving turns "no
+    # suffix" into a -1 tensor (never None), and the decode CUDA-graph keep_k
+    # buffer is likewise pre-filled with -1, so the -1/out-of-range fallback IS
+    # the path taken by every ordinary request — it must resolve to the nucleus
+    # default, not to a fixed K. Explicit -topN / -adaptN suffixes still override
+    # per token.
+    default_k = min(_KT_TOPK_K, E)
+    if _KT_ADAPT_NUCLEUS_P > 0:
+        default_K_vec = _kt_nucleus_keep_k(
+            w, E, _KT_ADAPT_NUCLEUS_P, _KT_ADAPT_KMIN, _KT_ADAPT_KMAX
+        )
+    else:
+        default_K_vec = torch.full((T,), default_k, device=w.device, dtype=torch.long)
+    if keep_k is None:
+        K_vec = default_K_vec
+    else:
+        raw_K_vec = keep_k[:T].to(device=w.device, dtype=torch.long)
+        # Per-request nucleus band: keep_k in [_KT_NUC_BASE-100, _KT_NUC_BASE]
+        # encodes nucleus routing at p = (_KT_NUC_BASE - keep_k)/100 for that
+        # token. Handled separately so it is NOT swept up by adaptive_level_mask.
+        nuc_mask = (raw_K_vec <= _KT_NUC_BASE) & (raw_K_vec >= _KT_NUC_BASE - 100)
+        adaptive_default_mask = raw_K_vec == -2
+        adaptive_level_mask = (raw_K_vec <= _KT_ADAPT_BASE) & ~nuc_mask
+        adaptive_mask = adaptive_default_mask | adaptive_level_mask
+        K_vec = torch.where(
+            (raw_K_vec < 0) | (raw_K_vec > E),
+            default_K_vec,
+            raw_K_vec,
+        )
+        speed_level = torch.where(
+            adaptive_level_mask,
+            torch.clamp((-raw_K_vec) + _KT_ADAPT_BASE, 0, 100),
+            torch.full_like(raw_K_vec, _KT_ADAPT_DEFAULT_SPEED),
+        )
+        K_vec = torch.where(
+            adaptive_mask,
+            _kt_adaptive_keep_k(w, E, speed_level=speed_level),
+            K_vec,
+        )
+        # Per-request nucleus rows override with per-token p from the encoding.
+        p_row = torch.clamp(
+            (_KT_NUC_BASE - raw_K_vec).to(torch.float32) / 100.0, 0.0, 1.0
+        )
+        K_vec = torch.where(
+            nuc_mask,
+            _kt_nucleus_keep_k(w, E, p_row, _KT_ADAPT_KMIN, _KT_ADAPT_KMAX),
+            K_vec,
+        )
+
+    # Per-layer/per-token N telemetry (capture-safe index_add_ into persistent
+    # per-layer buffers on the quant_method). "keep" = the K actually served this
+    # token; "natural" = nucleus-K at the fixed reference p, recorded regardless
+    # of the served mode so the router's own per-layer demand can be analyzed.
+    if quant_method is not None:
+        khist = getattr(quant_method, "_kt_keep_hist", None)
+        if khist is not None:
+            idx = K_vec.clamp(0, khist.shape[0] - 1).reshape(-1)
+            khist.index_add_(0, idx, torch.ones_like(idx, dtype=torch.float32))
+        nhist = getattr(quant_method, "_kt_natural_hist", None)
+        if nhist is not None:
+            nk = _kt_nucleus_keep_k(w, E, _KT_MEASURE_NUCLEUS_P, 1, E)
+            nidx = nk.clamp(0, nhist.shape[0] - 1).reshape(-1)
+            nhist.index_add_(0, nidx, torch.ones_like(nidx, dtype=torch.float32))
+
+    # Rank each of the E selected slots by weight, descending: rank[t, j] is the
+    # 0-based position of slot j among the token's selected experts (0 = biggest).
+    order = torch.argsort(w, dim=-1, descending=True)        # (T, E)
+    rank = torch.empty_like(order)
+    rank.scatter_(1, order, torch.arange(E, device=w.device).expand(T, E))
+    keep_mask = rank < K_vec[:, None]                        # (T, E) keep original?
+
+    if _KT_TOPK_MODE == "drop":
+        # zero the dropped weights, renormalize the kept K (ids untouched -> kt
+        # may still compute them but they contribute ~0 after renorm).
+        new_w = torch.where(keep_mask, w, torch.zeros_like(w))
+        denom = torch.clamp(new_w.sum(dim=-1, keepdim=True), min=1e-9)
+        topk_output.topk_weights.copy_(new_w / denom)
+        return
+
+    if _KT_TOPK_MODE == "safe":
+        mask = getattr(quant_method, "gpu_experts_mask_cuda", None)
+        if mask is None or router_logits is None:
+            return
+        scores = router_logits.float()  # (T, n_experts)
+        neg = torch.finfo(scores.dtype).min
+        allow_vec = mask.to(torch.bool)                       # (n_experts,)
+        # Three-tier store: an expert is REACHABLE if it is on GPU or staged in
+        # the host-RAM tier. `ram_vec` is None (or all-True complement of the GPU
+        # mask) in the historical two-tier setup, where every non-GPU expert is
+        # in RAM and `reach_vec` is therefore all-True.
+        ram_mask = getattr(quant_method, "ram_experts_mask_cuda", None)
+        reach_vec = allow_vec if ram_mask is None else (allow_vec | ram_mask.to(torch.bool))
+        # Candidate pool for the "nearest equivalent" fill.
+        fill_vec = allow_vec if _KT_TIER_FILL_POOL == "gpu" else reach_vec
+        allow = fill_vec.view(1, -1).expand(T, -1)
+        # "safe" = ACCURACY-SAFE keep: keep the genuine top-K ALWAYS (no residency
+        # filter), so a non-resident top-K expert survives and takes a CPU round-
+        # trip. Only the tail (ranks K..E-1) is substituted with resident experts,
+        # so the tail never hits the CPU. The genuine top-K is never dropped; the
+        # only CPU compute left is the non-resident members of the top-K, which
+        # the adaptive cache (retargeted to the top-K working set) drives toward 0.
+        #
+        # This is now the ONLY substitution mode. The residency-forcing variant
+        # ("sub") was removed: see _kt_read_topk_mode.
+        if ram_mask is not None:
+            # THREE-TIER SAFETY: an SSD-tier expert has weights in neither VRAM
+            # nor the kt CPU store, so it can never be kept — not even on the
+            # K == E passthrough tier, which is exact-baseline only while every
+            # expert is reachable. Dropping it here routes the slot to the fill
+            # pool (its nearest equivalent); leaving it would make the CPU
+            # kernel skip it via should_skip_expert and silently lose its mass.
+            # No-op in the two-tier setup, where reach_vec is all-True.
+            keep_mask = keep_mask & reach_vec[ids.long()]
+        if _KT_GPU_ONLY:
+            # GPU-ONLY MODE. Every expert this layer computes must already be on
+            # the GPU: either permanently resident, or streamed into a landing
+            # slot by the prefetcher during the previous layer. A genuine top-K
+            # expert that is neither gets substituted from the resident pool
+            # instead of taking a CPU round-trip.
+            #
+            # This is `top0` with the substitution made SELECTIVE by bandwidth.
+            # `top0` replaces every non-resident expert with a stand-in and costs
+            # 52.90 ms/step; full routing keeps them all and costs 149.48 because
+            # the CPU has to compute them. This mode keeps the ones the link had
+            # time to carry and substitutes only the remainder, so quality is
+            # strictly better than plain tier substitution at the same K and the
+            # CPU expert path is zero by construction rather than by 95.6%.
+            #
+            # `pf_landed` is published by layer L-1's predictor and cleared at the
+            # top of THIS layer's apply(), which runs after substitution -- so
+            # `pf_issued` is still the flag for the prediction that covers us.
+            # Without it the mask is last pass's and would keep experts whose
+            # bytes never arrived: fluent, wrong output, the Stage H11 failure.
+            landed = getattr(quant_method, "pf_landed", None)
