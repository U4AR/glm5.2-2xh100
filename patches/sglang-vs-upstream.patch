+_KT_NUC_RE = re.compile(r"-nuc(?:leus)?(\d{1,3})$", re.IGNORECASE)
+_KT_ADAPT_BASE = -1000
+_KT_ADAPT_DEFAULT_SPEED = 50
+_KT_NUC_BASE = -2000
