index 0000000..8698ca3
--- /dev/null
+++ b/kt-kernel/cpu_backend/cpu_expert_opts.h
@@ -0,0 +1,34 @@
+#ifndef CPUINFER_CPU_EXPERT_OPTS_H
+#define CPUINFER_CPU_EXPERT_OPTS_H
+
+#include <cstdlib>
+#include <string>
+#include <string_view>
+
+// Restart-scoped switches used to isolate the CPU expert optimizations. Parse
+// once so CUDA graph capture and replay always use the same implementation.
+inline bool kt_cpu_expert_opt_enabled(std::string_view option) {
+  static const std::string options = [] {
+    const char* value = std::getenv("KT_CPU_EXPERT_OPTS");
+    return value == nullptr ? std::string() : std::string(value);
+  }();
+
+  if (options.empty() || options == "none") return false;
+  if (options == "all") return true;
+
+  size_t begin = 0;
+  while (begin < options.size()) {
+    size_t end = options.find(',', begin);
+    if (end == std::string::npos) end = options.size();
+    size_t first = options.find_first_not_of(" \t", begin);
+    size_t last = end == begin ? std::string::npos : options.find_last_not_of(" \t", end - 1);
+    if (first != std::string::npos && first < end && last != std::string::npos &&
+        std::string_view(options).substr(first, last - first + 1) == option) {
+      return true;
+    }
+    begin = end + 1;
+  }
+  return false;
+}
+
+#endif  // CPUINFER_CPU_EXPERT_OPTS_H
diff --git a/kt-kernel/cpu_backend/cpu_expert_profile.h b/kt-kernel/cpu_backend/cpu_expert_profile.h
new file mode 100644
index 0000000..917c103
--- /dev/null
+++ b/kt-kernel/cpu_backend/cpu_expert_profile.h
@@ -0,0 +1,55 @@
+#ifndef KTRANSFORMERS_CPU_EXPERT_PROFILE_H
+#define KTRANSFORMERS_CPU_EXPERT_PROFILE_H
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+
+// Attribution-only counters for the CPU expert path. Enabled runs emit/reset
+// one 1,000-job window at a time so model-load work does not contaminate every
+// later decode sample. Absolute benchmarks always leave this disabled.
+struct KTCpuExpertProfile {
+  static inline std::atomic<unsigned long long> submit_callback_ns{0};
+  static inline std::atomic<unsigned long long> queue_delay_ns{0};
+  static inline std::atomic<unsigned long long> worker_execution_ns{0};
+  static inline std::atomic<unsigned long long> activation_quant_ns{0};
+  static inline std::atomic<unsigned long long> gemm_ns{0};
+  static inline std::atomic<unsigned long long> sync_wait_ns{0};
+  static inline std::atomic<unsigned long long> completed_jobs{0};
+
+  static bool enabled() {
+    static const bool value = [] {
+      const char* env = std::getenv("KT_CPU_EXPERT_PROFILE");
+      return env != nullptr && env[0] != '\0' && env[0] != '0';
+    }();
+    return value;
+  }
+
+  static unsigned long long now_ns() {
+    return (unsigned long long)std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+
+  static void add(std::atomic<unsigned long long>& counter, unsigned long long value) {
+    if (enabled()) counter.fetch_add(value, std::memory_order_relaxed);
+  }
+
+  static void finish_job() {
+    if (!enabled()) return;
+    const auto jobs = completed_jobs.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (jobs % 1000 != 0) return;
+    auto take_ms = [](std::atomic<unsigned long long>& counter) {
+      return counter.exchange(0, std::memory_order_relaxed) / 1.0e6;
+    };
+    std::fprintf(stderr,
+                 "[kt-cpu-profile] jobs=1000 submit_cb=%.3fms queue_delay=%.3fms "
+                 "worker=%.3fms quant=%.3fms gemm=%.3fms sync_wait=%.3fms\n",
+                 take_ms(submit_callback_ns), take_ms(queue_delay_ns), take_ms(worker_execution_ns),
+                 take_ms(activation_quant_ns), take_ms(gemm_ns), take_ms(sync_wait_ns));
+    std::fflush(stderr);
+  }
+};
+
+#endif
