diff --git a/kt-kernel/cpu_backend/expert_store_shm.h b/kt-kernel/cpu_backend/expert_store_shm.h
new file mode 100644
index 0000000..42482ce
--- /dev/null
+++ b/kt-kernel/cpu_backend/expert_store_shm.h
@@ -0,0 +1,109 @@
+/**
+ * Cross-process backing for the CPU expert store.
+ *
+ * The store is normally std::aligned_alloc'd into the owning process's private
+ * heap. That is fine for the CPU kernel, which is the only consumer -- but it
+ * makes the bytes unreachable from any OTHER process. Under TP>1 sglang runs
+ * one process per rank and kt only builds its store on rank 0, so a rank-1 GPU
+ * cannot map those pages and cannot gather an expert out of them.
+ *
+ * Routing the same allocations through a named POSIX shm segment fixes that
+ * without changing anything the CPU kernel sees: the pointers are still
+ * page-aligned, still bump-allocated in the same order, still first-touch
+ * (so `numa_set_localalloc` places pages on the touching thread's node exactly
+ * as with aligned_alloc), and still lazily populated -- ftruncate reserves
+ * address space, not physical memory, so an unstaged expert costs nothing.
+ *
+ * Off unless KT_STORE_SHM=1, so the default deployment keeps the private heap.
+ *
+ * Origin: expert-streaming-hybrid (Stage C, per-card gather needs BOTH ranks'
+ * PCIe links; one link cannot carry the traffic).
+ */
+
+#ifndef CPUINFER_EXPERT_STORE_SHM_H
+#define CPUINFER_EXPERT_STORE_SHM_H
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+class ExpertStoreShm {
+ public:
+  // One segment per (layer, TP partition). The name is derived, not random, so
+  // a reader in another process can reconstruct it from the same two integers
+  // plus the owner's pid -- which Python passes across ranks anyway.
+  static std::string make_name(int pid, int layer_idx, int tp_part) {
+    char buf[128];
+    std::snprintf(buf, sizeof(buf), "/ktstore_%d_l%d_t%d", pid, layer_idx, tp_part);
+    return std::string(buf);
+  }
+
+  ExpertStoreShm() = default;
+
+  ~ExpertStoreShm() {
+    if (base_ && base_ != MAP_FAILED) ::munmap(base_, size_);
+    if (fd_ >= 0) ::close(fd_);
+    // The name is unlinked immediately after every rank has opened it (see the
+    // Python side); if that never happened, drop it here so a crashed run does
+    // not leak a multi-GB segment into /dev/shm.
+    if (!name_.empty() && owner_) ::shm_unlink(name_.c_str());
+  }
+
+  void create(int layer_idx, int tp_part, size_t bytes) {
+    name_ = make_name(::getpid(), layer_idx, tp_part);
+    owner_ = true;
+    ::shm_unlink(name_.c_str());  // stale segment from a previous crashed run
+    fd_ = ::shm_open(name_.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+    if (fd_ < 0) throw std::runtime_error("shm_open failed for " + name_);
+    if (::ftruncate(fd_, (off_t)bytes) != 0) {
+      throw std::runtime_error("ftruncate failed for " + name_);
+    }
+    base_ = ::mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd_, 0);
+    if (base_ == MAP_FAILED) throw std::runtime_error("mmap failed for " + name_);
+    size_ = bytes;
+    cursor_ = 0;
+  }
+
+  // Page-aligned bump allocation, mirroring the aligned_alloc(kPageSize, n)
+  // calls it replaces. Returns nullptr if this segment was never created, so a
+  // caller can fall back to the private heap.
+  void* take(size_t bytes, size_t page) {
+    if (base_ == nullptr) return nullptr;
+    size_t off = (cursor_ + page - 1) & ~(page - 1);
+    if (off + bytes > size_) {
+      throw std::runtime_error("expert store shm exhausted: " + name_);
+    }
+    cursor_ = off + bytes;
+    last_offset_ = off;
+    return (void*)((uint8_t*)base_ + off);
+  }
+
+  bool active() const { return base_ != nullptr; }
+  const std::string& name() const { return name_; }
+  size_t size() const { return size_; }
+  size_t last_offset() const { return last_offset_; }
+  void* base() const { return base_; }
+
+  static bool enabled() {
+    const char* e = std::getenv("KT_STORE_SHM");
+    return e && e[0] == '1';
+  }
+
+ private:
+  std::string name_;
+  int fd_ = -1;
+  void* base_ = nullptr;
+  size_t size_ = 0;
+  size_t cursor_ = 0;
+  size_t last_offset_ = 0;
+  bool owner_ = false;
+};
+
+#endif  // CPUINFER_EXPERT_STORE_SHM_H
