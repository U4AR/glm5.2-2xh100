 void TaskQueue::enqueue(std::function<void()> task) {
+  Node* node = acquire_node();
+  node->task = std::move(task);
+  push_node(node);
+}
+
+void TaskQueue::enqueue_raw(void (*task)(void*), void* context) {
+  Node* node = acquire_node();
+  node->raw_task = task;
+  node->raw_context = context;
+  push_node(node);
+}
+
+TaskQueue::Node* TaskQueue::acquire_node() {
+  std::lock_guard<std::mutex> lock(node_pool_mtx);
+  if (!node_pool) return new Node();
+  if (free_nodes.empty()) return new Node();
+  Node* node = free_nodes.back();
+  free_nodes.pop_back();
+  node->task = nullptr;
+  node->raw_task = nullptr;
+  node->raw_context = nullptr;
+  node->next.store(nullptr, std::memory_order_relaxed);
+  return node;
+}
+
+void TaskQueue::release_node(Node* node) {
+  node->task = nullptr;
+  node->raw_task = nullptr;
+  node->raw_context = nullptr;
+  node->next.store(nullptr, std::memory_order_relaxed);
+  if (!node->pooled) {
+    delete node;
+    return;
+  }
+  std::lock_guard<std::mutex> lock(node_pool_mtx);
+  free_nodes.push_back(node);
+}
+
+void TaskQueue::push_node(Node* node) {
+  node->enqueue_ns = KTCpuExpertProfile::enabled() ? KTCpuExpertProfile::now_ns() : 0;
   pending.fetch_add(1, std::memory_order_acq_rel);
-  Node* node = new Node(task);
   Node* prev = tail.exchange(node, std::memory_order_acq_rel);
   prev->next.store(node, std::memory_order_release);
   {
@@ -63,10 +112,18 @@ void TaskQueue::worker() {
