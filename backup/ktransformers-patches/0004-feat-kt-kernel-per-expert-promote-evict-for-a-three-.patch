+  // Three-tier expert store: promote / evict a single expert at runtime.
+  // Both go through cpuinfer->enqueue so they execute on the CPU backend
+  // between submitted MoE jobs rather than racing one.
+  if constexpr (requires { &MoeClass::load_expert; }) {
+    struct LoadExpertBindings {
+      struct Args {
+        CPUInfer* cpuinfer;
+        MoeClass* moe;
+        int expert_id;
+        uintptr_t gate_ptr, up_ptr, down_ptr;
+        uintptr_t gate_scale_ptr, up_scale_ptr, down_scale_ptr;
+      };
+      static void inner(void* args) {
+        Args* a = (Args*)args;
+        a->cpuinfer->enqueue(&MoeClass::load_expert, a->moe, a->expert_id, a->gate_ptr, a->up_ptr, a->down_ptr,
+                             a->gate_scale_ptr, a->up_scale_ptr, a->down_scale_ptr);
+      }
+      static std::pair<intptr_t, intptr_t> cpuinfer_interface(std::shared_ptr<MoeClass> moe, int expert_id,
+                                                              uintptr_t gate_ptr, uintptr_t up_ptr, uintptr_t down_ptr,
+                                                              uintptr_t gate_scale_ptr, uintptr_t up_scale_ptr,
+                                                              uintptr_t down_scale_ptr) {
+        Args* args = new Args{nullptr,        moe.get(),      expert_id,     gate_ptr,
+                              up_ptr,         down_ptr,       gate_scale_ptr, up_scale_ptr,
+                              down_scale_ptr};
+        return std::make_pair((intptr_t)&inner, (intptr_t)args);
+      }
+    };
+    moe_cls.def("load_expert_task", &LoadExpertBindings::cpuinfer_interface, py::arg("expert_id"),
+                py::arg("gate_ptr"), py::arg("up_ptr"), py::arg("down_ptr"), py::arg("gate_scale_ptr"),
+                py::arg("up_scale_ptr"), py::arg("down_scale_ptr"));
+  }
+
+  if constexpr (requires { &MoeClass::release_expert; }) {
+    struct ReleaseExpertBindings {
+      struct Args {
+        CPUInfer* cpuinfer;
+        MoeClass* moe;
+        int expert_id;
+      };
+      static void inner(void* args) {
+        Args* a = (Args*)args;
+        a->cpuinfer->enqueue(&MoeClass::release_expert, a->moe, a->expert_id);
+      }
+      static std::pair<intptr_t, intptr_t> cpuinfer_interface(std::shared_ptr<MoeClass> moe, int expert_id) {
+        Args* args = new Args{nullptr, moe.get(), expert_id};
+        return std::make_pair((intptr_t)&inner, (intptr_t)args);
+      }
+    };
+    moe_cls.def("release_expert_task", &ReleaseExpertBindings::cpuinfer_interface, py::arg("expert_id"));
+  }
