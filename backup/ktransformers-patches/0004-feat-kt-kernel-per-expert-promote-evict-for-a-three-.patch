+        up_ptrs = [[t.data_ptr() for t in self.up_weights]]
+        down_ptrs = [[t.data_ptr() for t in self.down_weights]]
+
+        # BF16 has no scales, pass empty lists (will use 0/nullptr for consistency)
+        if self.method == "BF16":
