@@ -679,7 +679,47 @@ class BF16SafeTensorLoader(SafeTensorLoader):
 class CompressedSafeTensorLoader(SafeTensorLoader):
     """Loader for compressed SafeTensor layouts (RAWINT4 weights)."""
 
-    def load_experts(self, base_key: str, device: str = "cpu"):
+    def load_one_expert(self, base_key: str, expert_id: int, device: str = "cpu"):
+        """Load a SINGLE expert's six tensors, for runtime promotion into the
+        host-RAM tier of the three-tier expert store.
+
+        Returns a dict of tensors the caller must keep alive until the C++ copy
+        has completed (the pointers are handed over raw). Reuses the same
+        naming-convention probe as load_experts so both on-disk layouts work.
+        """
+        prefix, weight_suffix, scale_suffix = self._resolve_expert_naming(base_key)
+        out = {}
+        for proj in ("gate", "up", "down"):
+            wk = f"{prefix}.{expert_id}.{proj}_proj.{weight_suffix}"
+            sk = f"{prefix}.{expert_id}.{proj}_proj.{scale_suffix}"
+            if not self.has_tensor(wk):
+                raise KeyError(f"Missing tensor: {wk}")
+            if not self.has_tensor(sk):
+                raise KeyError(f"Missing tensor: {sk}")
+            out[proj] = self.load_tensor(wk, device).contiguous()
+            out[f"{proj}_scale"] = self.load_tensor(sk, device).contiguous()
+        return out
+
+    def _resolve_expert_naming(self, base_key: str):
+        """(experts_prefix, weight_suffix, scale_suffix) for this checkpoint."""
+
+        def probe(prefix):
+            for wsuf in ("weight_packed", "weight"):
+                if self.has_tensor(f"{prefix}.0.up_proj.{wsuf}"):
+                    return wsuf
+            return None
+
+        for prefix in (f"{base_key}.mlp.experts", f"language_model.{base_key}.mlp.experts"):
+            wsuf = probe(prefix)
+            if wsuf is None:
+                continue
+            ssuf = "weight_scale" if wsuf == "weight_packed" else "weight_scale_inv"
+            if not self.has_tensor(f"{prefix}.0.up_proj.{ssuf}"):
+                ssuf = "weight_scale_inv" if ssuf == "weight_scale" else "weight_scale"
+            return prefix, wsuf, ssuf
+        raise ValueError(f"No experts found for key {base_key}")
+
+    def load_experts(self, base_key: str, device: str = "cpu", skip=None):
         """Load raw expert weights stored in compressed safetensor format.
 
         Supports two on-disk naming conventions with byte-identical RAWINT4 payload
@@ -687,6 +727,14 @@ class CompressedSafeTensorLoader(SafeTensorLoader):
           - kt native compressed-tensors: .weight_packed / .weight_scale
           - W4AFP8 (GLM-5.2):             .weight        / .weight_scale_inv
         The W4AFP8 fp8 activation input_scale tensors are unused by RAWINT4.
+
+        `skip` is an optional per-expert boolean sequence: True means the expert
+        will not be staged in the CPU store, so its tensors are never read off
+        disk and `None` is returned in its slot. The caller passes 0 for those
+        pointers and C++ never dereferences them (should_skip_expert covers the
+        same set). Under a three-tier store with a small RAM tier this is the
+        difference between reading the whole 373 GB checkpoint at boot and
+        reading only the part that gets staged.
         """
 
         # Probe expert count + naming convention (try both weight suffixes).
@@ -718,6 +766,10 @@ class CompressedSafeTensorLoader(SafeTensorLoader):
             scale_entries = []
 
