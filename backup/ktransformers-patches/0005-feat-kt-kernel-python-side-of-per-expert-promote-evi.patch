+    def promote_expert(self, expert_id: int):
+        """Stage one expert into the CPU store, reading it off disk now.
+
+        The caller must have cleared the expert's bit in gpu_experts_mask (kt's
+        skip mask) so nothing routes to it while the buffers are being written,
+        and must set the bit back to resident only after this returns.
+        """
+        if self.loader is None:
+            self.loader = NativeMoEWrapper._native_loader_instance
+        if self.loader is None or not hasattr(self.loader, "load_one_expert"):
+            raise RuntimeError(
+                "promote_expert needs a loader with load_one_expert "
+                "(CompressedSafeTensorLoader); is KT_TIER_KEEP_LOADER=1 set?"
+            )
+        w = self.loader.load_one_expert(self._expert_base_key(), int(expert_id))
+        # Tensors must outlive the C++ copy: submit + sync before they drop.
+        self.cpu_infer.submit(
+            self.moe.load_expert_task(
+                expert_id=int(expert_id),
+                gate_ptr=w["gate"].data_ptr(),
+                up_ptr=w["up"].data_ptr(),
+                down_ptr=w["down"].data_ptr(),
+                gate_scale_ptr=w["gate_scale"].data_ptr(),
+                up_scale_ptr=w["up_scale"].data_ptr(),
+                down_scale_ptr=w["down_scale"].data_ptr(),
+            )
+        )
+        self.cpu_infer.sync()
+        del w
+
+    def evict_expert(self, expert_id: int):
+        """Drop one expert's weights from host RAM (madvise). The caller must
+        have masked the expert out first."""
+        self.cpu_infer.submit(self.moe.release_expert_task(expert_id=int(expert_id)))
+        self.cpu_infer.sync()
