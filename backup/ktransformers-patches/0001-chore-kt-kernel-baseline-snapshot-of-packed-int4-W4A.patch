diff --git a/kt-kernel/operators/avx2/rawint4_packed_avx512vnni-moe.hpp b/kt-kernel/operators/avx2/rawint4_packed_avx512vnni-moe.hpp
new file mode 100644
index 0000000..f971d27
--- /dev/null
+++ b/kt-kernel/operators/avx2/rawint4_packed_avx512vnni-moe.hpp
@@ -0,0 +1,643 @@
+/**
+ * @Description  : AVX-512-VNNI PACKED RAWINT4 MoE operator (Kimi native INT4 layout)
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Memory-bandwidth-optimized variant of rawint4_avxvnni-moe.hpp.
+ *
+ * The original AVX-VNNI-256 RAWINT4 backend (a) requires the VEX AVX-VNNI ISA
+ * (avx_vnni), which the deployment CPU (AMD EPYC 9V84 / Zen4 Genoa) does NOT
+ * expose -- it has avx512_vnni (EVEX) but not avx_vnni, so _mm256_dpbusd_avx_*
+ * is an illegal instruction here -- and (b) pre-expands the packed int4 weights
+ * into int8 [N, K] *at load time*, so at inference it streams 1 byte/weight from
+ * DRAM, exactly as many bytes as FP8. On single-stream decode the CPU-expert
+ * window is MEMORY-BANDWIDTH-BOUND (measured ~140-220 GB/s in-window vs ~170 GB/s
+ * achievable on this VM), so that expansion throws away the whole point of int4.
+ *
+ * This backend fixes both: it uses AVX-512 VNNI (EVEX, 256-bit ops via AVX512VL,
+ * which the CPU supports), and it keeps the weights PACKED at 4-bit in DRAM
+ * (0.5 byte/weight), unpacking each byte's two nibbles into signed int8
+ * *in-register* immediately before VPDPBUSD. Halving the weight bytes ~halves the
+ * memory-bound window. The extra unpack ALU ops are free because the window is
+ * memory-bound, not compute-bound.
+ *
+ * Source layout (identical to rawint4-moe.hpp / rawint4_avxvnni-moe.hpp):
+ *   weights [N, K/2] uint8  (two signed int4 values per byte, value = nibble - 8,
+ *                            low nibble = even k, high nibble = odd k)
+ *   scales  [N, K/group_size] bf16
+ *
+ * W4A8: weights are 4-bit; activations are quantized on the fly to group-wise
+ * int8 (biased to uint8 for dpbusd). dpbusd does the group-wise inner product,
+ * followed by the +128 activation-offset compensation (128 * weight_sum) and a
+ * rescale by (a_scale * w_scale). The activation path is byte-for-byte identical
+ * to the original kernel -- all the memory win is on the weight side.
+ *
+ * 256-bit EVEX (not 512) is intentional: the window is memory-bound so SIMD width
+ * gives no compute gain (Zen4 double-pumps AVX-512 anyway), and the 256-bit
+ * nibble deinterleave stays within 128-bit lanes (no cross-lane permute), keeping
+ * it simple and obviously correct. A 512-bit variant is a future front-end-relief
+ * bonus only.
+ **/
+#ifndef CPUINFER_OPERATOR_AVX2_RAW_INT4_PACKED_AVX512_MOE_H
+#define CPUINFER_OPERATOR_AVX2_RAW_INT4_PACKED_AVX512_MOE_H
+
+#include <immintrin.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+
+#include "avx2_bf16_utils.hpp"
+#include "moe_base.hpp"
+
+#if defined(__GNUC__) || defined(__clang__)
+// 256-bit dpbusd uses the EVEX encoding gated by AVX512VL+AVX512VNNI; AVX512BW is
+// needed for the byte ops in the nibble unpack. The target attribute lets these
+// functions compile even in an AVX2-only ("portable") build; runtime use is gated
+// by __builtin_cpu_supports in derived_init().
+#define KT_AVX512_RAWINT4_PACKED_TARGET __attribute__((target("avx512f,avx512bw,avx512vl,avx512vnni")))
+#else
+#define KT_AVX512_RAWINT4_PACKED_TARGET
+#endif
+
+namespace avx512_rawint4_packed {
+
+static constexpr int MAX_SUPPORTED_GROUP_SIZE = 256;
+
+KT_AVX512_RAWINT4_PACKED_TARGET
+static inline int hsum_epi32_avx2(__m256i v) {
+  __m128i lo = _mm256_castsi256_si128(v);
+  __m128i hi = _mm256_extracti128_si256(v, 1);
+  __m128i sum = _mm_add_epi32(lo, hi);
+  sum = _mm_hadd_epi32(sum, sum);
+  sum = _mm_hadd_epi32(sum, sum);
+  return _mm_cvtsi128_si32(sum);
+}
+
+// Quantize one activation group to biased uint8 for dpbusd.
+// Returns the activation scale. A return value of 0 means the group is all zero.
+// (Identical to the non-packed backend -- the activation path is not touched.)
+KT_AVX512_RAWINT4_PACKED_TARGET
+static inline float quantize_activation_group_u8(const ggml_bf16_t* src, int group_size, uint8_t* dst) {
+  float absmax = 0.0f;
+
+  for (int i = 0; i < group_size; ++i) {
+    absmax = std::max(absmax, std::fabs(GGML_BF16_TO_FP32(src[i])));
+  }
+
+  if (absmax <= std::numeric_limits<float>::min()) {
+    std::memset(dst, 0x80, (size_t)group_size);
+    return 0.0f;
+  }
+
+  const float scale = absmax / 127.0f;
+  const float inv_scale = 1.0f / scale;
+  for (int i = 0; i < group_size; ++i) {
+    int q = (int)std::lrint(GGML_BF16_TO_FP32(src[i]) * inv_scale);
+    q = std::clamp(q, -127, 127);
+    dst[i] = (uint8_t)(((uint8_t)(int8_t)q) ^ 0x80);
+  }
+  return scale;
+}
+
+// Unpack 16 packed bytes (32 nibbles) into a 256-bit vector of 32 signed int8
+// weights in K-contiguous order [k0,k1,...,k31].
+//   lo nibble = even k, hi nibble = odd k  ->  interleave(lo, hi) = [k0,k1,k2,...]
+// The unpacklo/unpackhi stay within 128-bit lanes, so set_m128i(w1, w0) yields
+// [k0..k15 | k16..k31] -- exactly the K-contiguous order of the activation lane,
+// which is all VPDPBUSD needs (it horizontally sums the whole group anyway).
+//
+// W4AFP8 stores TWO'S-COMPLEMENT signed int4 (verified against the coherent GPU
+// cutlass path: value = nibble>=8 ? nibble-16 : nibble), NOT offset-binary. That
+// equals (nibble XOR 8) - 8, so we XOR the nibble with 8 before subtracting 8.
+KT_AVX512_RAWINT4_PACKED_TARGET
+static inline __m256i unpack_int4_chunk(const uint8_t* w_packed, __m128i mask0f, __m256i eight) {
+  const __m128i pk = _mm_loadu_si128((const __m128i*)w_packed);     // 16 bytes = 32 nibbles
+  const __m128i lo = _mm_and_si128(pk, mask0f);                     // low nibbles  -> k0,k2,...,k30
+  const __m128i hi = _mm_and_si128(_mm_srli_epi16(pk, 4), mask0f);  // high nibbles -> k1,k3,...,k31
+  const __m128i w0 = _mm_unpacklo_epi8(lo, hi);                     // [k0..k15]
+  const __m128i w1 = _mm_unpackhi_epi8(lo, hi);                     // [k16..k31]
+  const __m256i w = _mm256_set_m128i(w1, w0);                       // [k0..k31] in 0..15
+  return _mm256_sub_epi8(_mm256_xor_si256(w, eight), eight);        // (n^8)-8 -> two's-comp -8..7
+}
+
+struct GemmKernelAVX512RawInt4Packed {
+  using dt = ggml_bf16_t;
+  using output_t = float;
+  static constexpr int M_STEP = 1;
+  static constexpr int N_STEP = 8;
+  static constexpr int K_STEP = 8;
+  static constexpr int N_BLOCK = 64;
+  static constexpr int K_BLOCK = 128;
+  static constexpr double ELEMENT_SIZE = 0.5;
+
+  static void config() {}
+
+  static int recommended_nth(int n) { return std::max(1, n / N_BLOCK); }
+
+  static std::pair<int, int> split_range_n(int n, int ith, int nth) { return avx2::split_range(n, ith, nth); }
+
+  struct BufferA {
+    ggml_bf16_t* data = nullptr;
+    size_t max_m = 0;
+    size_t k = 0;
+
+    BufferA() = default;
+    BufferA(size_t m, size_t k_, void* ptr) : data((ggml_bf16_t*)ptr), max_m(m), k(k_) {}
+
+    static size_t required_size(size_t m, size_t k) { return m * k * sizeof(ggml_bf16_t); }
+
+    void set_data(void* ptr) { data = (ggml_bf16_t*)ptr; }
+
+    void from_mat(int m, const ggml_bf16_t* src, int ith, int nth) {
+      if (ith == 0 && nth == 1) {
+        std::memcpy(data, src, (size_t)m * k * sizeof(ggml_bf16_t));
+      } else {
+        auto [m_start, m_end] = avx2::split_range(m, ith, nth);
+        std::memcpy(data + m_start * k, src + m_start * k, (size_t)(m_end - m_start) * k * sizeof(ggml_bf16_t));
+      }
+    }
+  };
+
+  struct BufferB {
+    // THE fix vs rawint4_avxvnni-moe.hpp: weights STAY packed at 4-bit in DRAM.
+    uint8_t* qweight_packed = nullptr;  // [N, K/2] uint8 (low nibble = even k, high nibble = odd k)
+    float* scales = nullptr;            // [N, num_groups] float32 (converted from bf16)
+    int16_t* weight_sums = nullptr;     // [N, num_groups] per-group sum of unpacked signed int8 weights
+    int n = 0;
+    int k = 0;
+    int group_size = 128;
+    int num_groups = 0;
+
+    BufferB() = default;
+    BufferB(size_t n_, size_t k_, int gs, void* ptr) : n((int)n_), k((int)k_), group_size(gs) {
+      if (group_size <= 0 || (group_size % 32) != 0) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires group_size to be a positive multiple of 32");
+      }
+      if (group_size > MAX_SUPPORTED_GROUP_SIZE) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires group_size <= 256");
+      }
+      if ((k % 8) != 0 || (k % group_size) != 0) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires k to be divisible by both 8 and group_size");
+      }
+      num_groups = k / group_size;
+      qweight_packed = (uint8_t*)ptr;
+      scales = (float*)((uint8_t*)ptr + ((size_t)k / 2) * n * sizeof(uint8_t));
+      weight_sums = (int16_t*)((uint8_t*)scales + (size_t)num_groups * n * sizeof(float));
+    }
+
+    // Scale-only allocation: qweight_packed points to external (mmap'd) packed weight
+    // data set later in load_weights(); only scales + weight_sums are owned here. This
+    // is the natural zero-copy path for a packed kernel (we keep weights packed anyway).
+    BufferB(int n_, int k_, int gs, void* sums_scale_ptr, std::nullptr_t /*scale_only*/)
+        : qweight_packed(nullptr), n(n_), k(k_), group_size(gs) {
+      if (group_size <= 0 || (group_size % 32) != 0) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires group_size to be a positive multiple of 32");
+      }
+      if (group_size > MAX_SUPPORTED_GROUP_SIZE) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires group_size <= 256");
+      }
+      if ((k % 8) != 0 || (k % group_size) != 0) {
+        throw std::runtime_error("AVX-512 PACKED RAWINT4 requires k to be divisible by both 8 and group_size");
+      }
+      num_groups = k / group_size;
+      scales = (float*)sums_scale_ptr;
+      weight_sums = (int16_t*)((uint8_t*)scales + (size_t)num_groups * n * sizeof(float));
+    }
+
+    static size_t required_size(size_t n, size_t k, int gs) {
+      const size_t num_groups = k / gs;
+      // ~half the weight term vs the expanded kernel: (k/2)*n instead of k*n.
+      return (k / 2) * n * sizeof(uint8_t) + num_groups * n * sizeof(float) + num_groups * n * sizeof(int16_t);
+    }
+
+    // Scale-only size: float32 scales + int16 weight_sums (packed weights live externally).
+    static size_t required_size_scale_only(size_t n, size_t k, int gs) {
+      const size_t num_groups = k / gs;
+      return num_groups * n * sizeof(float) + num_groups * n * sizeof(int16_t);
+    }
+
+    // Per-expert (zero-copy) finalize: qweight_packed must already point at the external
+    // packed data. Convert bf16 group scales -> float32 and compute int16 weight_sums
+    // directly from the packed nibbles. Runs over all N rows (one task per expert).
+    void finalize_external(const ggml_bf16_t* src_scales) {
+      convert_or_copy(scales, src_scales, (size_t)n * num_groups);
+      const size_t row_bytes = (size_t)k / 2;
+      for (int ni = 0; ni < n; ++ni) {
+        const uint8_t* src_row = qweight_packed + (size_t)ni * row_bytes;
+        int16_t* dst_ws_row = weight_sums + (size_t)ni * num_groups;
+        for (int g = 0; g < num_groups; ++g) {
+          const int byte_base = (g * group_size) / 2;
+          int sum = 0;
+          for (int bi = 0; bi < group_size / 2; ++bi) {
+            const uint8_t packed = src_row[byte_base + bi];
+            sum += ((int)(packed & 0x0F) - 8) + ((int)((packed >> 4) & 0x0F) - 8);
+          }
+          dst_ws_row[g] = (int16_t)sum;
+        }
+      }
+    }
+
+    // Keep packed RAWINT4 weights [n_len, k/2] PACKED (just memcpy the rows), convert
+    // bf16 scales [n_len, num_groups] to float32, and compute int16 weight_sums
+    // [n_len, num_groups] directly from the packed nibbles (no int8 expansion).
+    void from_raw_mat(const uint8_t* src_packed, const ggml_bf16_t* src_scales, int ith, int nth) {
+      if (qweight_packed == nullptr) return;  // scale-only mode: handled by finalize_external()
+      auto [n_start, n_end] = avx2::split_range(n, ith, nth);
+      const size_t row_bytes = (size_t)k / 2;
+
+      for (int ni = n_start; ni < n_end; ++ni) {
+        const uint8_t* src_row = src_packed + (size_t)ni * row_bytes;
+        uint8_t* dst_row = qweight_packed + (size_t)ni * row_bytes;
+        const ggml_bf16_t* src_sc_row = src_scales + (size_t)ni * num_groups;
+        float* dst_sc_row = scales + (size_t)ni * num_groups;
+        int16_t* dst_ws_row = weight_sums + (size_t)ni * num_groups;
+
+        // Keep weights packed.
+        std::memcpy(dst_row, src_row, row_bytes);
+
+        for (int g = 0; g < num_groups; ++g) {
+          const int k_base = g * group_size;
+          int sum = 0;
+          for (int kk = 0; kk < group_size; kk += 2) {
+            const uint8_t packed = src_row[(k_base + kk) / 2];
+            const int n0 = packed & 0x0F;               // even k nibble
+            const int n1 = (packed >> 4) & 0x0F;        // odd k nibble
+            sum += (n0 >= 8 ? n0 - 16 : n0) + (n1 >= 8 ? n1 - 16 : n1);  // two's-complement
+          }
+          dst_ws_row[g] = (int16_t)sum;
+          dst_sc_row[g] = GGML_BF16_TO_FP32(src_sc_row[g]);
+        }
+      }
+    }
+  };
+
+  struct BufferC {
+    float* data = nullptr;
+    size_t max_m = 0;
+    size_t n = 0;
+
+    BufferC() = default;
+    BufferC(size_t m, size_t n_, void* ptr) : data((float*)ptr), max_m(m), n(n_) {}
+
+    static size_t required_size(size_t m, size_t n) { return m * n * sizeof(float); }
+
+    void set_data(void* ptr) { data = (float*)ptr; }
+
+    void to_mat(int m, ggml_bf16_t* dst, int ith, int nth) {
+      auto [n_start, n_end] = avx2::split_range((int)n, ith, nth);
+      for (int mi = 0; mi < m; ++mi) {
+        float* src_row = data + mi * n;
+        ggml_bf16_t* dst_row = dst + mi * n;
+        int j = n_start;
+        for (; j + 8 <= n_end; j += 8) {
+          avx2::store_fp32_to_bf16(dst_row + j, _mm256_loadu_ps(src_row + j));
+        }
+        for (; j < n_end; ++j) {
+          dst_row[j] = GGML_FP32_TO_BF16(src_row[j]);
+        }
+      }
+    }
+  };
+};
+
+KT_AVX512_RAWINT4_PACKED_TARGET
+static inline void gemm_rawint4_packed_avx512(int m, int n, int k, GemmKernelAVX512RawInt4Packed::BufferA& a,
+                                              GemmKernelAVX512RawInt4Packed::BufferB& b,
+                                              GemmKernelAVX512RawInt4Packed::BufferC& c, int ith, int nth) {
+  (void)k;
+  auto [n_start, n_end] = avx2::split_range(n, ith, nth);
+  const int group_size = b.group_size;
+  const int num_groups = b.num_groups;
+  const size_t row_bytes = (size_t)b.k / 2;
+
+  const __m128i mask0f = _mm_set1_epi8(0x0F);
+  const __m256i eight = _mm256_set1_epi8(8);
+
+  alignas(32) std::array<uint8_t, MAX_SUPPORTED_GROUP_SIZE> a_u8{};
+
+  for (int mi = 0; mi < m; ++mi) {
+    const ggml_bf16_t* a_row = a.data + (size_t)mi * a.k;
+    float* c_row = c.data + (size_t)mi * n;
+    std::fill(c_row + n_start, c_row + n_end, 0.0f);
+
+    for (int g = 0; g < num_groups; ++g) {
+      const int k_base = g * group_size;
+      const float a_scale = quantize_activation_group_u8(a_row + k_base, group_size, a_u8.data());
+      if (a_scale == 0.0f) {
+        continue;
+      }
+
+      for (int ni = n_start; ni < n_end; ++ni) {
+        __m256i acc = _mm256_setzero_si256();
+        // Packed weight row for output n, starting at this group (k_base/2 bytes in).
+        const uint8_t* w_col = b.qweight_packed + (size_t)ni * row_bytes + (size_t)(k_base / 2);
+        for (int kk = 0; kk < group_size; kk += 32) {
+          const __m256i a_vec = _mm256_load_si256((const __m256i*)(a_u8.data() + kk));
+          const __m256i w_vec = unpack_int4_chunk(w_col + (kk / 2), mask0f, eight);
+          acc = _mm256_dpbusd_epi32(acc, a_vec, w_vec);
+        }
+
+        const int dot = hsum_epi32_avx2(acc) - 128 * (int)b.weight_sums[(size_t)ni * num_groups + g];
+        c_row[ni] += (float)dot * a_scale * b.scales[(size_t)ni * num_groups + g];
+      }
+    }
+  }
+}
+
+}  // namespace avx512_rawint4_packed
