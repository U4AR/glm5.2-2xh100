+
+  void write_weight_scale_to_buffer_serial(int gpu_tp_count, int expert_id,
+                                           const std::vector<uintptr_t>& w13_weight_ptrs,
+                                           const std::vector<uintptr_t>& w13_scale_ptrs,
+                                           const std::vector<uintptr_t>& w2_weight_ptrs,
+                                           const std::vector<uintptr_t>& w2_scale_ptrs) {
+    if (this->weights_loaded == false) throw std::runtime_error("Not Loaded");
+    if ((int)w13_weight_ptrs.size() != gpu_tp_count || (int)w13_scale_ptrs.size() != gpu_tp_count ||
+        (int)w2_weight_ptrs.size() != gpu_tp_count || (int)w2_scale_ptrs.size() != gpu_tp_count) {
+      throw std::runtime_error("Pointer arrays size must match gpu_tp_count");
+    }
+    bool debug = std::getenv("KT_TOPK_DEBUG") != nullptr;
+    for (int i = 0; i < this->tp_count; ++i) {
+      if (debug) {
+        std::fprintf(stderr, "[kt-topk] serial tp=%d expert=%d\n", i, expert_id);
+        std::fflush(stderr);
+      }
+      this->tps[i]->write_weights_to_buffer_single_thread(gpu_tp_count, this->tp_count, expert_id, this->config,
+                                                          w13_weight_ptrs, w13_scale_ptrs, w2_weight_ptrs,
+                                                          w2_scale_ptrs);
+    }
+  }
+
+  void write_weight_scale_to_buffer_local(int gpu_tp_count, int local_gpu_tp, int expert_id,
+                                          const std::vector<uintptr_t>& w13_weight_ptrs,
+                                          const std::vector<uintptr_t>& w13_scale_ptrs,
+                                          const std::vector<uintptr_t>& w2_weight_ptrs,
+                                          const std::vector<uintptr_t>& w2_scale_ptrs) {
+    if (this->weights_loaded == false) throw std::runtime_error("Not Loaded");
+    if ((int)w13_weight_ptrs.size() != gpu_tp_count || (int)w13_scale_ptrs.size() != gpu_tp_count ||
+        (int)w2_weight_ptrs.size() != gpu_tp_count || (int)w2_scale_ptrs.size() != gpu_tp_count) {
+      throw std::runtime_error("Pointer arrays size must match gpu_tp_count");
+    }
+    if (this->tp_count < gpu_tp_count) {
+      throw std::runtime_error("Local top-k streaming currently requires cpu_tp_count >= gpu_tp_count");
+    }
+    bool debug = std::getenv("KT_TOPK_DEBUG") != nullptr;
+    int cpu_per_gpu_tp = this->tp_count / gpu_tp_count;
+    for (int i = 0; i < this->tp_count; ++i) {
+      int target_gpu_tp = i / cpu_per_gpu_tp;
+      if (target_gpu_tp != local_gpu_tp) continue;
+      if (debug) {
+        std::fprintf(stderr, "[kt-topk] local tp=%d gpu_tp=%d expert=%d\n", i, local_gpu_tp, expert_id);
+        std::fflush(stderr);
+      }
+      this->tps[i]->write_weights_to_buffer_single_thread(gpu_tp_count, this->tp_count, expert_id, this->config,
+                                                          w13_weight_ptrs, w13_scale_ptrs, w2_weight_ptrs,
+                                                          w2_scale_ptrs);
+    }
+  }
