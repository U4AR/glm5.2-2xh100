@@ -477,10 +480,266 @@ void bind_moe_module(py::module_& moe_module, const char* name) {
     moe_cls.def("write_weight_scale_to_buffer_task", &WriteWeightScaleToBufferBindings::cpuinfer_interface,
                 py::arg("gpu_tp_count"), py::arg("expert_id"), py::arg("w13_weight_ptrs"), py::arg("w13_scale_ptrs"),
                 py::arg("w2_weight_ptrs"), py::arg("w2_scale_ptrs"));
+
+    struct WriteTopKWeightScaleToBufferBindings {
+      struct Args {
+	        CPUInfer* cpuinfer;
+	        MoeClass* moe;
+	        int gpu_tp_count;
+	        int local_gpu_tp;
+	        int slot_count;
+	        int num_experts;
+	        int base_slot;
+        uintptr_t selected_ids_ptr;
+        uintptr_t gpu_mask_ptr;
+        uintptr_t static_l2g_ptr;
+        uintptr_t dyn_mask_ptr;
+        uintptr_t dyn_l2g_ptr;
+        size_t w13_weight_slot_bytes;
+        size_t w13_scale_slot_bytes;
+        size_t w2_weight_slot_bytes;
+        size_t w2_scale_slot_bytes;
+        uintptr_t ready_counter_ptr;
+        int w13_scale_rows;
+        int w13_scale_groups;
+        int w2_scale_rows;
+        int w2_scale_groups;
+        std::vector<uintptr_t> w13_weight_ptrs;
+        std::vector<uintptr_t> w13_scale_ptrs;
+        std::vector<uintptr_t> w2_weight_ptrs;
+        std::vector<uintptr_t> w2_scale_ptrs;
+      };
+
+      static std::vector<uintptr_t> offset_ptrs(const std::vector<uintptr_t>& ptrs, size_t slot_bytes, int slot) {
+        std::vector<uintptr_t> out;
+        out.reserve(ptrs.size());
+        for (auto ptr : ptrs) out.push_back(ptr + (size_t)slot * slot_bytes);
+        return out;
+      }
+
+      static void interleave_bf16_scale_inplace(uintptr_t ptr, int rows, int groups) {
+        if (ptr == 0 || rows <= 0 || groups <= 0) return;
+        int alignment = (groups % 4 == 0) ? 4 : 1;
+        auto* data = reinterpret_cast<uint16_t*>(ptr);
+        std::vector<uint16_t> tmp((size_t)rows * (size_t)groups);
+        for (int row = 0; row < rows; ++row) {
+          for (int group = 0; group < groups; ++group) {
+            size_t src = (size_t)row * groups + group;
+            size_t dst = (size_t)(group / alignment) * ((size_t)rows * alignment) +
+                         (size_t)row * alignment + (group % alignment);
+            tmp[dst] = data[src];
+          }
+        }
+        std::memcpy(data, tmp.data(), tmp.size() * sizeof(uint16_t));
+      }
+
+	      static void inner(void* args) {
+	        Args* args_ = (Args*)args;
+	        args_->cpuinfer->task_queue_->enqueue([args_]() { work(args_); });
+	      }
+
+	      static void write_one_expert(Args* args_, int64_t expert_id, int slot) {
+	        if constexpr (requires(MoeClass* moe, int gpu_tp_count, int local_gpu_tp, int expert,
+	                               const std::vector<uintptr_t>& w13_weight_ptrs,
+	                               const std::vector<uintptr_t>& w13_scale_ptrs,
+	                               const std::vector<uintptr_t>& w2_weight_ptrs,
+	                               const std::vector<uintptr_t>& w2_scale_ptrs) {
+	                        moe->write_weight_scale_to_buffer_local(gpu_tp_count, local_gpu_tp, expert,
+	                                                                w13_weight_ptrs, w13_scale_ptrs, w2_weight_ptrs,
+	                                                                w2_scale_ptrs);
+	                      }) {
+	          if (args_->local_gpu_tp < 0) {
+	            args_->moe->write_weight_scale_to_buffer_serial(
+	                args_->gpu_tp_count, (int)expert_id,
+	                offset_ptrs(args_->w13_weight_ptrs, args_->w13_weight_slot_bytes, slot),
+	                offset_ptrs(args_->w13_scale_ptrs, args_->w13_scale_slot_bytes, slot),
+	                offset_ptrs(args_->w2_weight_ptrs, args_->w2_weight_slot_bytes, slot),
+	                offset_ptrs(args_->w2_scale_ptrs, args_->w2_scale_slot_bytes, slot));
+	            return;
+	          }
+	          args_->moe->write_weight_scale_to_buffer_local(
+	              args_->gpu_tp_count, args_->local_gpu_tp, (int)expert_id,
+	              offset_ptrs(args_->w13_weight_ptrs, args_->w13_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w13_scale_ptrs, args_->w13_scale_slot_bytes, slot),
+	              offset_ptrs(args_->w2_weight_ptrs, args_->w2_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w2_scale_ptrs, args_->w2_scale_slot_bytes, slot));
+	        } else if constexpr (requires(MoeClass* moe, int gpu_tp_count, int expert,
+	                               const std::vector<uintptr_t>& w13_weight_ptrs,
+	                               const std::vector<uintptr_t>& w13_scale_ptrs,
+	                               const std::vector<uintptr_t>& w2_weight_ptrs,
+	                               const std::vector<uintptr_t>& w2_scale_ptrs) {
+	                        moe->write_weight_scale_to_buffer_serial(gpu_tp_count, expert, w13_weight_ptrs,
+	                                                                 w13_scale_ptrs, w2_weight_ptrs,
+	                                                                 w2_scale_ptrs);
+	                      }) {
+	          args_->moe->write_weight_scale_to_buffer_serial(
+	              args_->gpu_tp_count, (int)expert_id,
+	              offset_ptrs(args_->w13_weight_ptrs, args_->w13_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w13_scale_ptrs, args_->w13_scale_slot_bytes, slot),
+	              offset_ptrs(args_->w2_weight_ptrs, args_->w2_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w2_scale_ptrs, args_->w2_scale_slot_bytes, slot));
+	        } else {
+	          args_->moe->write_weight_scale_to_buffer(
+	              args_->gpu_tp_count, (int)expert_id,
+	              offset_ptrs(args_->w13_weight_ptrs, args_->w13_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w13_scale_ptrs, args_->w13_scale_slot_bytes, slot),
+	              offset_ptrs(args_->w2_weight_ptrs, args_->w2_weight_slot_bytes, slot),
+	              offset_ptrs(args_->w2_scale_ptrs, args_->w2_scale_slot_bytes, slot));
+	        }
+	      }
+
+	      static void work(Args* args_) {
+	        bool debug = std::getenv("KT_TOPK_DEBUG") != nullptr;
+	        const int64_t* selected_ids = reinterpret_cast<const int64_t*>(args_->selected_ids_ptr);
+	        const uint8_t* gpu_mask = reinterpret_cast<const uint8_t*>(args_->gpu_mask_ptr);
+	        const int64_t* static_l2g = reinterpret_cast<const int64_t*>(args_->static_l2g_ptr);
+	        uint8_t* dyn_mask = reinterpret_cast<uint8_t*>(args_->dyn_mask_ptr);
+        int64_t* dyn_l2g = reinterpret_cast<int64_t*>(args_->dyn_l2g_ptr);
+
+        if (debug) {
+	          std::fprintf(stderr, "[kt-topk] begin local_gpu_tp=%d slots=%d base=%d selected_ptr=%p ready=%p\n",
+	                       args_->local_gpu_tp, args_->slot_count, args_->base_slot, selected_ids,
+	                       reinterpret_cast<void*>(args_->ready_counter_ptr));
+          std::fflush(stderr);
+        }
+        std::memcpy(dyn_mask, gpu_mask, (size_t)args_->num_experts * sizeof(uint8_t));
+        std::memcpy(dyn_l2g, static_l2g, (size_t)args_->num_experts * sizeof(int64_t));
+
+        std::vector<int> written_slots;
+        written_slots.reserve(args_->slot_count);
+        for (int slot = 0; slot < args_->slot_count; ++slot) {
+          int64_t expert_id = selected_ids[slot];
+          if (debug) {
+            std::fprintf(stderr, "[kt-topk] slot=%d expert=%ld gpu=%d\n",
+                         slot, (long)expert_id,
+                         (expert_id >= 0 && expert_id < args_->num_experts) ? (int)gpu_mask[expert_id] : -1);
+            std::fflush(stderr);
+          }
+          if (expert_id < 0 || expert_id >= args_->num_experts) continue;
+          if (gpu_mask[expert_id]) continue;
+
+          dyn_mask[expert_id] = 1;
+          dyn_l2g[expert_id] = args_->base_slot + slot;
+	          if (debug) {
+	            std::fprintf(stderr, "[kt-topk] write slot=%d expert=%ld\n", slot, (long)expert_id);
+	            std::fflush(stderr);
+	          }
+	          write_one_expert(args_, expert_id, slot);
+	          written_slots.push_back(slot);
+	        }
+	        for (int slot : written_slots) {
+	          if (debug) {
+	            std::fprintf(stderr, "[kt-topk] interleave slot=%d\n", slot);
+            std::fflush(stderr);
+          }
+	          if (args_->local_gpu_tp >= 0) {
+	            interleave_bf16_scale_inplace(args_->w13_scale_ptrs[args_->local_gpu_tp] +
+	                                              (size_t)slot * args_->w13_scale_slot_bytes,
+	                                          args_->w13_scale_rows, args_->w13_scale_groups);
+	            interleave_bf16_scale_inplace(args_->w2_scale_ptrs[args_->local_gpu_tp] +
+	                                              (size_t)slot * args_->w2_scale_slot_bytes,
+	                                          args_->w2_scale_rows, args_->w2_scale_groups);
+	          } else {
+	            for (auto ptr : args_->w13_scale_ptrs) {
+	              interleave_bf16_scale_inplace(ptr + (size_t)slot * args_->w13_scale_slot_bytes,
+	                                            args_->w13_scale_rows, args_->w13_scale_groups);
+	            }
+	            for (auto ptr : args_->w2_scale_ptrs) {
+	              interleave_bf16_scale_inplace(ptr + (size_t)slot * args_->w2_scale_slot_bytes,
+	                                            args_->w2_scale_rows, args_->w2_scale_groups);
+	            }
+	          }
+	        }
+        if (args_->ready_counter_ptr != 0) {
+          auto* counter = reinterpret_cast<int64_t*>(args_->ready_counter_ptr);
+          __atomic_fetch_add(counter, (int64_t)1, __ATOMIC_RELEASE);
+        }
+        if (debug) {
+          std::fprintf(stderr, "[kt-topk] done\n");
+          std::fflush(stderr);
+        }
+      }
+
+      static std::pair<intptr_t, intptr_t> cpuinfer_interface(
+	          std::shared_ptr<MoeClass> moe, int gpu_tp_count, int local_gpu_tp, int slot_count, int num_experts,
+	          int base_slot, uintptr_t selected_ids_ptr, uintptr_t gpu_mask_ptr, uintptr_t static_l2g_ptr,
+	          uintptr_t dyn_mask_ptr, uintptr_t dyn_l2g_ptr, size_t w13_weight_slot_bytes,
+	          size_t w13_scale_slot_bytes, size_t w2_weight_slot_bytes, size_t w2_scale_slot_bytes,
+	          uintptr_t ready_counter_ptr, int w13_scale_rows, int w13_scale_groups, int w2_scale_rows, int w2_scale_groups,
+	          py::list w13_weight_ptrs, py::list w13_scale_ptrs, py::list w2_weight_ptrs, py::list w2_scale_ptrs) {
+        std::vector<uintptr_t> w13_weight_vec, w13_scale_vec, w2_weight_vec, w2_scale_vec;
+
+        for (auto item : w13_weight_ptrs) w13_weight_vec.push_back(py::cast<uintptr_t>(item));
+        for (auto item : w13_scale_ptrs) w13_scale_vec.push_back(py::cast<uintptr_t>(item));
+        for (auto item : w2_weight_ptrs) w2_weight_vec.push_back(py::cast<uintptr_t>(item));
+        for (auto item : w2_scale_ptrs) w2_scale_vec.push_back(py::cast<uintptr_t>(item));
+
+        Args* args = new Args{nullptr,
+	                              moe.get(),
+	                              gpu_tp_count,
+	                              local_gpu_tp,
+	                              slot_count,
+                              num_experts,
+                              base_slot,
+                              selected_ids_ptr,
+                              gpu_mask_ptr,
+                              static_l2g_ptr,
+                              dyn_mask_ptr,
+                              dyn_l2g_ptr,
+                              w13_weight_slot_bytes,
+                              w13_scale_slot_bytes,
+                              w2_weight_slot_bytes,
+                              w2_scale_slot_bytes,
+                              ready_counter_ptr,
+                              w13_scale_rows,
+                              w13_scale_groups,
+                              w2_scale_rows,
+                              w2_scale_groups,
+                              w13_weight_vec,
+                              w13_scale_vec,
+                              w2_weight_vec,
+                              w2_scale_vec};
+        return std::make_pair((intptr_t)&inner, (intptr_t)args);
+      }
+    };
+
+	    moe_cls.def("write_topk_weight_scale_to_buffer_task",
+	                &WriteTopKWeightScaleToBufferBindings::cpuinfer_interface, py::arg("gpu_tp_count"),
+	                py::arg("local_gpu_tp"), py::arg("slot_count"), py::arg("num_experts"), py::arg("base_slot"),
+                py::arg("selected_ids_ptr"), py::arg("gpu_mask_ptr"), py::arg("static_l2g_ptr"),
+                py::arg("dyn_mask_ptr"), py::arg("dyn_l2g_ptr"), py::arg("w13_weight_slot_bytes"),
+                py::arg("w13_scale_slot_bytes"), py::arg("w2_weight_slot_bytes"),
+                py::arg("w2_scale_slot_bytes"), py::arg("ready_counter_ptr"), py::arg("w13_scale_rows"),
+                py::arg("w13_scale_groups"), py::arg("w2_scale_rows"), py::arg("w2_scale_groups"),
+                py::arg("w13_weight_ptrs"), py::arg("w13_scale_ptrs"), py::arg("w2_weight_ptrs"),
+                py::arg("w2_scale_ptrs"));
+  }
+}
+
+struct WaitCounterArgs {
+  int64_t* counter;
+  int64_t expected;
+};
+
+static void wait_counter_inner(void* raw_args) {
+  auto* args = reinterpret_cast<WaitCounterArgs*>(raw_args);
+  while (__atomic_load_n(args->counter, __ATOMIC_ACQUIRE) < args->expected) {
+    std::this_thread::yield();
   }
+  args->expected += 1;
 }
 
 PYBIND11_MODULE(kt_kernel_ext, m) {
+  m.def("launch_wait_counter", [](intptr_t user_cuda_stream, uintptr_t counter_ptr) {
+    auto* counter = reinterpret_cast<int64_t*>(counter_ptr);
+    int64_t expected = __atomic_load_n(counter, __ATOMIC_ACQUIRE) + 1;
+    auto* args = new WaitCounterArgs{counter, expected};
+#if defined(KTRANSFORMERS_USE_CUDA) || defined(KTRANSFORMERS_USE_MUSA) || defined(KTRANSFORMERS_USE_ROCM) || \
+    defined(KTRANSFORMERS_USE_MACA)
+    cudaLaunchHostFunc((cudaStream_t)user_cuda_stream, (cudaHostFn_t)&wait_counter_inner, (void*)args);
+#endif
+  });
+
   py::class_<WorkerPool>(m, "WorkerPool").def(py::init<int>());
   py::class_<WorkerPoolConfig>(m, "WorkerPoolConfig")
       .def(py::init<>())
