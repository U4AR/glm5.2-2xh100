# ---- heavy / regenerable (NOT part of the baseline source) ----
# model checkpoints — a real dir (from download_w4afp8.py) OR a machine-local
# symlink to fast scratch. Either way it must never be committed. Configure the
# path in config.sh (WEIGHTS_DIR); download with int4_scripts/download_w4afp8.py.
/weights
.venv/
.hf/
.dl-venv/
.pipcache/
tmp/
scratch/
.runtime/
.triton-cache/
# Terminal-Bench harness (harbor venv + task clone) — bootstrapped by
# bench/terminalbench/setup_terminalbench.sh, never committed.
.terminalbench/
__pycache__/
*.pyc
*.log
logs/
*.bak-preC
*.bak-prepacked
# ktransformers has its own git repo; backed up there (commit in place)
ktransformers/

# ---- baseline Python overlays ----------------------------------------------
# (force-added with `git add -f`; listed here as documentation)
!.venv/lib/python3.12/site-packages/sglang/srt/layers/quantization/w4afp8.py
!.venv/lib/python3.12/site-packages/sglang/srt/server_args.py
!.venv/lib/python3.12/site-packages/sglang/srt/models/deepseek_v2.py
!.venv/lib/python3.12/site-packages/sglang/srt/layers/attention/nsa_backend.py
!.venv/lib/python3.12/site-packages/sglang/srt/layers/moe/kt_ep_wrapper.py
!.venv/lib/python3.12/site-packages/kt_kernel/utils/amx.py
# MTP/NEXTN-under-CUDA-graphs fixes (2026-06-30): kt verify-batch buffer
# registration + multi-step draft warmup hook. See BLOG / memory.
!.venv/lib/python3.12/site-packages/sglang/srt/model_executor/cuda_graph_runner.py
!.venv/lib/python3.12/site-packages/sglang/srt/layers/attention/triton_backend.py
# Per-request "intelligence" tier via OpenAI model name "<base>-topN" (2026-06-30):
# per-token keep_k plumbed Req -> ModelWorkerBatch -> ForwardBatch -> CUDA-graph
# buffer -> deepseek_v2 routing kernel, switchable live per request, mixed-batch.
!.venv/lib/python3.12/site-packages/sglang/srt/managers/schedule_batch.py
!.venv/lib/python3.12/site-packages/sglang/srt/model_executor/forward_batch_info.py
!.venv/lib/python3.12/site-packages/sglang/srt/entrypoints/openai/serving_chat.py
!.venv/lib/python3.12/site-packages/sglang/srt/entrypoints/http_server.py

